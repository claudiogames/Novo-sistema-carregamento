        function handleSpreadsheetFile(event) {
            const file = event.target.files && event.target.files[0];
            event.target.value = '';
            if (!file) return;

            if (typeof XLSX === 'undefined') {
                showToast('Biblioteca SheetJS não disponível.', 'error');
                return;
            }

            const reader = new FileReader();
            reader.onload = async (ev) => {
                try {
                    const data = new Uint8Array(ev.target.result);
                    const wb = XLSX.read(data, { type: 'array', raw: false });
                    const firstSheet = wb.Sheets[wb.SheetNames[0]];
                    const rows = XLSX.utils.sheet_to_json(firstSheet, { defval: '', raw: false });

                    const imported = [];
                    const seen = new Set();
                    rows.forEach((row) => {
                        const mapped = mapSupabaseRow(row);
                        if (mapped && !seen.has(mapped.matricula)) {
                            seen.add(mapped.matricula);
                            imported.push(mapped);
                        }
                    });

                    if (imported.length === 0) {
                        showToast('Nenhuma linha válida encontrada na planilha.', 'warning');
                        return;
                    }

                    imported.forEach((item) => saveOrUpdateLocalEmployee(item));
                    showToast(`${imported.length} colaborador(es) carregado(s). Sincronizando com Supabase...`, 'info');

                    if (supabaseClient) {
                        const tableName = (sbConfig.table || 'colaboradores').trim();
                        const matCol = (sbConfig.colMatricula || 'matricula').trim();
                        const nomeCol = (sbConfig.colNome || 'nome').trim();
                        const funcaoCol = (sbConfig.colFuncao || 'funcao').trim();
                        const lotacaoCol = (sbConfig.colLotacao || 'lotacao').trim();

                        const payload = imported.map((item) => ({
                            [matCol]: item.matricula,
                            [nomeCol]: item.nome,
                            [funcaoCol]: item.funcao,
                            [lotacaoCol]: item.lotacao || ''
                        }));

                        for (let i = 0; i < payload.length; i += 250) {
                            const chunk = payload.slice(i, i + 250);
                            const { error } = await supabaseClient
                                .from(tableName)
                                .upsert(chunk, { onConflict: matCol });
                            if (error) throw error;
                        }
                        showToast(`Planilha sincronizada com o Supabase (${imported.length} registros)!`, 'success');
                    }
                } catch (err) {
                    console.error('Erro ao importar planilha:', err);
                    showToast(`Erro ao importar planilha: ${err?.message || err}`, 'warning');
                }
            };
            reader.readAsArrayBuffer(file);
        }

        function exportDatabaseXLSX() {
            if (typeof XLSX === 'undefined') {
                showToast('Biblioteca SheetJS não disponível.', 'error');
                return;
            }
            if (employees.length === 0) {
                showToast('Base vazia para exportar.', 'warning');
                return;
            }
            const ws = XLSX.utils.json_to_sheet(employees.map((e) => ({
                Matricula: e.matricula,
                Nome: e.nome,
                Funcao: e.funcao,
                Lotacao: e.lotacao || ''
            })));
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'Colaboradores');
            XLSX.writeFile(wb, `colaboradores_grendene_${dateStamp()}.xlsx`);
        }

        /* =====================================================================
           BIPADOR VIA CÂMERA (ZXING + BARCODEDETECTOR + IMAGEM)
           ===================================================================== */
        async function toggleCamera() {
            if (isScanningCamera) {
                await stopCamera();
            } else {
                await startCamera();
            }
        }

        async function startCamera() {
            if (!window.ZXing || !window.ZXing.BrowserMultiFormatReader) {
                showToast('Leitor de câmera ZXing indisponível. Use o campo de texto ou foto.', 'warning');
                return;
            }

            const panel = document.getElementById('cameraPanel');
            const videoEl = document.getElementById('cameraVideo');
            const labelEl = document.getElementById('cameraToggleLabel');
            const engineEl = document.getElementById('cameraEngineLabel');

            panel.classList.remove('hidden');
            labelEl.textContent = 'Parar Câmera';

            try {
                if (!zxingReader) {
                    zxingReader = new window.ZXing.BrowserMultiFormatReader();
                }

                const constraints = {
                    video: {
                        facingMode: { ideal: 'environment' },
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    },
                    audio: false
                };

                activeStream = await navigator.mediaDevices.getUserMedia(constraints);
                videoEl.srcObject = activeStream;
                await videoEl.play();

                activeVideoTrack = activeStream.getVideoTracks()[0] || null;
                if (activeVideoTrack && activeVideoTrack.getCapabilities) {
                    const caps = activeVideoTrack.getCapabilities();
                    if (caps.torch) {
                        document.getElementById('torchBtn').classList.remove('hidden');
                    }
                }

                isScanningCamera = true;
                const hasNativeDetector = typeof window.BarcodeDetector !== 'undefined';
                engineEl.textContent = hasNativeDetector
                    ? 'Motor: BarcodeDetector + ZXing ativo'
                    : 'Motor: ZXing MultiFormat ativo';

                let nativeDetector = null;
                if (hasNativeDetector) {
                    try {
                        nativeDetector = new window.BarcodeDetector({
                            formats: ['code_128', 'code_39', 'code_93', 'codabar', 'ean_13', 'ean_8', 'upc_a', 'upc_e', 'itf', 'qr_code']
                        });
                    } catch (_) {
                        nativeDetector = null;
                    }
                }

                zxingReader.decodeFromStream(activeStream, videoEl, async (result) => {
                    if (!isScanningCamera) return;
                    if (result && result.getText) {
                        consumeCameraCode(result.getText());
                        return;
                    }
                    if (nativeDetector && videoEl.readyState >= 2) {
                        try {
                            const codes = await nativeDetector.detect(videoEl);
                            if (codes && codes.length > 0 && codes[0].rawValue) {
                                consumeCameraCode(codes[0].rawValue);
                            }
                        } catch (_) {
                            // Ignora frame não decodificado
                        }
                    }
                });
            } catch (err) {
                console.error('Erro ao abrir câmera:', err);
                showToast('Não foi possível acessar a câmera. Verifique as permissões.', 'error');
                await stopCamera();
            }
        }

        function consumeCameraCode(codeText) {
            const cleaned = String(codeText || '').trim();
            if (!cleaned) return;
            const now = Date.now();
            if (cleaned === lastCameraCode && (now - lastCameraTime) < 1800) return;
            lastCameraCode = cleaned;
            lastCameraTime = now;
            processBarcode(cleaned);
        }

        async function stopCamera() {
            isScanningCamera = false;
            torchEnabled = false;

            if (zxingReader) {
                try {
                    zxingReader.reset();
                } catch (_) {}
            }

            if (activeStream) {
                activeStream.getTracks().forEach((track) => track.stop());
                activeStream = null;
            }
            activeVideoTrack = null;

            const videoEl = document.getElementById('cameraVideo');
            if (videoEl) videoEl.srcObject = null;

            document.getElementById('cameraPanel').classList.add('hidden');
            document.getElementById('torchBtn').classList.add('hidden');
            document.getElementById('cameraToggleLabel').textContent = 'Bipar Câmera';
            focusScanInput();
        }

        async function toggleTorch() {
            if (!activeVideoTrack || !activeVideoTrack.applyConstraints) return;
            try {
                torchEnabled = !torchEnabled;
                await activeVideoTrack.applyConstraints({ advanced: [{ torch: torchEnabled }] });
                showToast(torchEnabled ? 'Flash ativado' : 'Flash desativado', 'info');
            } catch (_) {
                showToast('Flash não suportado neste dispositivo.', 'warning');
            }
        }

        function handleImageBarcodeScan(event) {
            const file = event.target.files && event.target.files[0];
            event.target.value = '';
            if (!file || !window.ZXing || !window.ZXing.BrowserMultiFormatReader) return;

            const reader = new FileReader();
            reader.onload = async (ev) => {
                try {
                    const tempReader = new window.ZXing.BrowserMultiFormatReader();
                    const res = await tempReader.decodeFromImageUrl(ev.target.result);
                    if (res && res.getText) {
                        processBarcode(res.getText());
                    } else {
                        showToast('Nenhum código encontrado na imagem.', 'warning');
                    }
                } catch (_) {
                    showToast('Não foi possível ler código de barras nesta foto.', 'warning');
                }
            };
            reader.readAsDataURL(file);
        }

