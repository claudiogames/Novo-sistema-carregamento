        function saveOrUpdateLocalEmployee(record, originalKey = '') {
            if (originalKey && originalKey !== record.matricula) {
                employees = employees.filter((e) => e.matricula !== originalKey);
            }
            const idx = employees.findIndex((e) => e.matricula === record.matricula);
            if (idx >= 0) {
                employees[idx] = { ...record };
            } else {
                employees.unshift({ ...record });
            }
            localStorage.setItem(STORAGE_KEYS.EMPLOYEES, JSON.stringify(employees));
            renderEmployeesTable();
        }

