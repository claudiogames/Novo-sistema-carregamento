<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grendene - Identificação de Colaboradores (Supabase)</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Fonte Inter e JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">

    <!-- Supabase JS v2 (jsDelivr principal + fallback automático para unpkg) -->
    <script id="supabaseSdkScript" src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js" onload="handleSupabaseSdkLoaded()" onerror="loadSupabaseSdkFallback()"></script>

    <!-- ZXing Browser para leitura de códigos de barras via câmera -->
    <script src="https://unpkg.com/@zxing/library@0.21.3/umd/index.min.js"></script>

    <!-- SheetJS (XLSX) para leitura e exportação de planilhas .xlsx / .csv -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>

    <!-- Ícones Lucide -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        };
    </script>

    <style>
        :root, [data-theme="light"] {
            --bg-main: #f1f5f9;
            --bg-surface: #ffffff;
            --bg-surface-alt: #f8fafc;
            --bg-header: #ffffff;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --accent: #004a8f;
            --accent-hover: #003566;
            --accent-soft: rgba(0, 74, 143, 0.1);
            --input-bg: #ffffff;
        }

        [data-theme="dark"] {
            --bg-main: #090d16;
            --bg-surface: #111827;
            --bg-surface-alt: #1e293b;
            --bg-header: #0f172a;
            --text-primary: #f8fafc;
            --text-secondary: #cbd5e1;
            --text-muted: #94a3b8;
            --border-color: #293548;
            --accent: #3b82f6;
            --accent-hover: #2563eb;
            --accent-soft: rgba(59, 130, 246, 0.16);
            --input-bg: #1e293b;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-primary);
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .card {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-color);
        }

        .card-alt {
            background-color: var(--bg-surface-alt);
            border: 1px solid var(--border-color);
        }

        .header-surface {
            background-color: var(--bg-header);
            border-bottom: 1px solid var(--border-color);
        }

        .field-input {
            background-color: var(--input-bg);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
        }

        .field-input:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-soft);
        }

        .btn-accent {
            background-color: var(--accent);
            color: #ffffff;
        }

        .btn-accent:hover {
            background-color: var(--accent-hover);
        }

        @keyframes scanBeam {
            0%, 100% { top: 16%; opacity: 0.45; }
            50% { top: 84%; opacity: 1; }
        }

        .scan-beam {
            position: absolute;
            left: 10%;
            right: 10%;
            height: 2px;
            background: #ef4444;
            box-shadow: 0 0 8px #ef4444, 0 0 16px rgba(239, 68, 68, 0.8);
            animation: scanBeam 2s ease-in-out infinite;
            pointer-events: none;
        }

        @keyframes pulseFound {
            0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.55); }
            100% { box-shadow: 0 0 0 14px rgba(16, 185, 129, 0); }
        }

        .flash-found {
            animation: pulseFound 0.75s ease-out;
        }

        @keyframes pulseWarn {
            0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.55); }
            100% { box-shadow: 0 0 0 14px rgba(245, 158, 11, 0); }
        }

        .flash-warn {
            animation: pulseWarn 0.75s ease-out;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-blue-600 selection:text-white">

    <!-- CABEÇALHO -->
    <header class="header-surface sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
            <!-- Logo e Título -->
            <div class="flex items-center gap-3 min-w-0">
                <div class="bg-white px-2.5 py-1.5 rounded-xl border border-slate-200 flex-shrink-0 flex items-center justify-center">
                    <img
                        id="grendeneLogo"
                        src="https://sindcalf.org.br/wp-content/uploads/2017/06/grendene.jpg"
                        alt="Grendene"
                        class="h-8 sm:h-9 w-auto object-contain"
                        onerror="handleLogoError(this)"
                    >
                    <span id="grendeneLogoFallback" class="hidden px-1.5 py-0.5 text-xs font-extrabold tracking-wider text-[#004a8f]">
                        GRENDENE
                    </span>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <h1 class="font-bold text-sm sm:text-base tracking-tight truncate">Identificador de Crachás</h1>
                        <span class="hidden md:inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-mono font-bold bg-blue-600/10 text-blue-600">
                            8 DÍGITOS
                        </span>
                    </div>
                    <p class="text-xs truncate" style="color: var(--text-secondary);">Leitura de código de barras • Supabase</p>
                </div>
            </div>

            <!-- Status Supabase + Controles -->
            <div class="flex items-center gap-2 flex-shrink-0">
                <button
                    type="button"
                    onclick="syncFromSupabase(true)"
                    id="supabaseStatusBtn"
                    title="Testar e sincronizar tabela colaboradores no Supabase"
                    class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-semibold card-alt hover:opacity-90 transition cursor-pointer"
                >
                    <span id="supabaseStatusDot" class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                    <span id="supabaseStatusText" class="max-w-[210px] truncate">Supabase: Verificando...</span>
                    <i id="supabaseSyncIcon" data-lucide="refresh-cw" class="w-3.5 h-3.5" style="color: var(--text-muted);"></i>
                </button>

                <button
                    type="button"
                    onclick="syncFromSupabase(true)"
                    id="reconnectSupabaseBtn"
                    title="Reconectar e buscar colaboradores no Supabase"
                    class="flex items-center gap-1.5 px-2.5 py-2 rounded-xl text-xs font-semibold card-alt hover:opacity-90 transition cursor-pointer"
                >
                    <i data-lucide="plug-zap" class="w-4 h-4 text-blue-500"></i>
                    <span class="hidden xl:inline">Reconectar</span>
                </button>

                <button
                    type="button"
                    onclick="toggleAutoFocus()"
                    id="autoFocusBtn"
                    title="Alternar foco automático contínuo no campo de leitura"
                    class="flex items-center gap-1.5 px-2.5 py-2 rounded-xl text-xs font-semibold card-alt hover:opacity-90 transition cursor-pointer"
                >
                    <i data-lucide="scan-barcode" class="w-4 h-4 text-emerald-500"></i>
                    <span class="hidden lg:inline">Auto-Foco:</span>
                    <span id="autoFocusState" class="font-mono font-bold text-emerald-500">ON</span>
                </button>

                <button
                    type="button"
                    onclick="toggleSound()"
                    id="soundBtn"
                    title="Ativar ou desativar som do bipador"
                    class="p-2 rounded-xl card-alt hover:opacity-90 transition cursor-pointer"
                >
                    <i id="soundIcon" data-lucide="volume-2" class="w-4 h-4 text-blue-500"></i>
                </button>

                <button
                    type="button"
                    onclick="toggleTheme()"
                    id="themeBtn"
                    title="Alternar tema claro / escuro"
                    class="p-2 rounded-xl card-alt hover:opacity-90 transition cursor-pointer"
                >
                    <i id="themeIcon" data-lucide="moon" class="w-4 h-4"></i>
                </button>

                <button
                    type="button"
                    onclick="openConfigModal()"
                    title="Configurar Supabase, colunas e regras de prefixo"
                    class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold btn-accent hover:opacity-95 transition cursor-pointer"
                >
                    <i data-lucide="settings" class="w-4 h-4"></i>
                    <span class="hidden sm:inline">Configurar</span>
                </button>
            </div>
        </div>

        <!-- Barra de Navegação -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-2 overflow-x-auto border-t" style="border-color: var(--border-color);">
            <div class="flex gap-1">
                <button
                    type="button"
                    onclick="switchTab('bipador')"
                    id="tab-bipador"
                    class="flex items-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-semibold border-b-2 border-blue-600 text-blue-600 whitespace-nowrap cursor-pointer"
                >
                    <i data-lucide="barcode" class="w-4 h-4"></i>
                    Bipador &amp; Identificação
                </button>
                <button
                    type="button"
                    onclick="switchTab('base')"
                    id="tab-base"
                    class="flex items-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-medium border-b-2 border-transparent whitespace-nowrap cursor-pointer"
                    style="color: var(--text-secondary);"
                >
                    <i data-lucide="database" class="w-4 h-4"></i>
                    Colaboradores
                    <span id="totalColaboradoresBadge" class="px-2 py-0.5 text-[11px] font-mono font-bold rounded-full card-alt">0</span>
                </button>
            </div>

            <div class="hidden md:flex items-center gap-2 text-xs py-2" style="color: var(--text-muted);">
                <span>Prefixos ativos:</span>
                <code id="activePrefixSummary" class="font-mono font-semibold px-2 py-0.5 rounded card-alt" style="color: var(--text-primary);">Letras + Zeros à esq.</code>
            </div>
        </div>
    </header>

    <!-- TOASTS -->
    <div id="toastArea" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full px-4 sm:px-0 pointer-events-none"></div>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- BANNER DE DIAGNÓSTICO DO SUPABASE (Exibido quando há erro de tabela/RLS/conexão) -->
        <div id="supabaseDiagnosticBanner" class="hidden card rounded-2xl p-4 sm:p-5 border-amber-500/50 bg-amber-500/5 space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                <div class="flex items-start gap-3">
                    <div class="p-2 rounded-xl bg-amber-500/15 text-amber-500 flex-shrink-0 mt-0.5">
                        <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                    </div>
                    <div class="space-y-1">
                        <h2 id="diagTitle" class="font-bold text-sm text-amber-500">Diagnóstico da Conexão Supabase</h2>
                        <p id="diagDescription" class="text-xs sm:text-sm" style="color: var(--text-secondary);"></p>
                        <p id="diagTechnicalError" class="font-mono text-xs px-2.5 py-1.5 rounded-lg card-alt break-all" style="color: var(--text-primary);"></p>
                    </div>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0">
                    <button type="button" onclick="syncFromSupabase(true)" class="px-3 py-2 rounded-xl text-xs font-semibold btn-accent flex items-center gap-1.5 cursor-pointer">
                        <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Testar Novamente
                    </button>
                    <button type="button" onclick="openConfigModal()" class="px-3 py-2 rounded-xl text-xs font-semibold card-alt flex items-center gap-1.5 cursor-pointer">
                        <i data-lucide="sliders" class="w-3.5 h-3.5"></i> Ajustar Tabela / SQL
                    </button>
                </div>
            </div>
        </div>

        <!-- =============================================================== -->
        <!-- ABA 1: BIPADOR & IDENTIFICAÇÃO                                  -->
        <!-- =============================================================== -->
        <section id="view-bipador" class="space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                <!-- COLUNA ESQUERDA: LEITOR FÍSICO + CÂMERA (5 cols) -->
                <div class="lg:col-span-5 space-y-4">
                    <div class="card rounded-2xl p-5 shadow-2xs space-y-4">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5" style="color: var(--accent);">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                Bipador de Crachá
                            </span>
                            <span id="sourceModeBadge" class="text-[11px] font-mono font-semibold px-2.5 py-0.5 rounded-full card-alt" style="color: var(--text-secondary);">
                                Padrão: 8 dígitos • -1 final
                            </span>
                        </div>

                        <form id="scanForm" onsubmit="handleScanSubmit(event)" class="space-y-3">
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                                    <i data-lucide="scan-line" class="w-5 h-5" style="color: var(--text-muted);"></i>
                                </span>
                                <input
                                    type="text"
                                    id="barcodeInput"
                                    autocomplete="off"
                                    autocorrect="off"
                                    autocapitalize="off"
                                    spellcheck="false"
                                    placeholder="Bipe o crachá ou digite a matrícula..."
                                    class="field-input w-full pl-11 pr-10 py-3.5 rounded-xl font-mono text-base sm:text-lg font-bold tracking-wider transition"
                                >
                                <button
                                    type="button"
                                    onclick="clearScanInput()"
                                    title="Limpar campo"
                                    class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer"
                                    style="color: var(--text-muted);"
                                >
                                    <i data-lucide="x" class="w-4 h-4"></i>
                                </button>
                            </div>

                            <div class="grid grid-cols-2 gap-2.5">
                                <button type="submit" class="btn-accent py-3 px-4 rounded-xl text-sm font-semibold flex items-center justify-center gap-2 transition cursor-pointer">
                                    <i data-lucide="search" class="w-4 h-4"></i>
                                    Buscar
                                </button>
                                <button
                                    type="button"
                                    id="cameraToggleBtn"
                                    onclick="toggleCamera()"
                                    class="py-3 px-4 rounded-xl text-sm font-semibold card-alt hover:opacity-90 flex items-center justify-center gap-2 transition cursor-pointer"
                                >
                                    <i data-lucide="camera" class="w-4 h-4 text-blue-500"></i>
                                    <span id="cameraToggleLabel">Bipar Câmera</span>
                                </button>
                            </div>
                        </form>

                        <!-- CÂMERA INTEGRADA -->
                        <div id="cameraPanel" class="hidden pt-3 border-t space-y-2.5" style="border-color: var(--border-color);">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold flex items-center gap-1.5">
                                    <i data-lucide="video" class="w-4 h-4 text-red-500"></i>
                                    Câmera ativa — aponte para o código
                                </span>
                                <div class="flex items-center gap-2">
                                    <button
                                        type="button"
                                        id="torchBtn"
                                        onclick="toggleTorch()"
                                        class="hidden text-xs font-semibold px-2.5 py-1 rounded-lg bg-amber-500/15 text-amber-500 flex items-center gap-1 cursor-pointer"
                                    >
                                        <i data-lucide="zap" class="w-3.5 h-3.5"></i> Flash
                                    </button>
                                    <button
                                        type="button"
                                        onclick="stopCamera()"
                                        class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-red-500/15 text-red-500 cursor-pointer"
                                    >
                                        Parar
                                    </button>
                                </div>
                            </div>

                            <div class="relative rounded-xl overflow-hidden bg-black aspect-video flex items-center justify-center">
                                <video id="cameraVideo" class="w-full h-full object-cover" playsinline muted></video>
                                <div class="scan-beam"></div>
                            </div>

                            <div class="flex items-center justify-between gap-2">
                                <span id="cameraEngineLabel" class="text-[11px] font-mono" style="color: var(--text-muted);">
                                    Motor: ZXing / BarcodeDetector
                                </span>
                                <label class="text-[11px] font-semibold text-blue-500 hover:underline cursor-pointer flex items-center gap-1">
                                    <i data-lucide="image" class="w-3.5 h-3.5"></i> Ler foto do código
                                    <input type="file" accept="image/*" capture="environment" onchange="handleImageBarcodeScan(event)" class="hidden">
                                </label>
                            </div>
                        </div>

                        <!-- COMPARATIVO BRUTO VS LIMPO -->
                        <div class="pt-3 border-t grid grid-cols-2 gap-3" style="border-color: var(--border-color);">
                            <div class="card-alt p-3 rounded-xl">
                                <span class="block text-[10px] font-bold uppercase tracking-wider" style="color: var(--text-muted);">Código Bipado</span>
                                <span id="rawCodeDisplay" class="font-mono text-sm font-bold truncate block mt-0.5">—</span>
                            </div>
                            <div class="card-alt p-3 rounded-xl">
                                <span class="block text-[10px] font-bold uppercase tracking-wider text-emerald-500">Matrícula (8 dígitos)</span>
                                <span id="cleanCodeDisplay" class="font-mono text-sm font-extrabold text-emerald-500 truncate block mt-0.5">—</span>
                            </div>
                        </div>
                    </div>

                    <!-- TESTE RÁPIDO DE PREFIXOS / MATRÍCULAS -->
                    <div class="card rounded-2xl p-4 shadow-2xs space-y-2.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--text-secondary);">Simular Bipagem</span>
                            <span class="text-[11px]" style="color: var(--text-muted);">Testa sufixo "1" e prefixos</span>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <button type="button" onclick="processBarcode('139322901')" class="text-xs font-mono px-2.5 py-1.5 rounded-lg card-alt hover:border-blue-500 transition cursor-pointer">
                                139322901 (+1 fim)
                            </button>
                            <button type="button" onclick="processBarcode('00013932290')" class="text-xs font-mono px-2.5 py-1.5 rounded-lg card-alt hover:border-blue-500 transition cursor-pointer">
                                00013932290
                            </button>
                            <button type="button" onclick="processBarcode('GR139235551')" class="text-xs font-mono px-2.5 py-1.5 rounded-lg card-alt hover:border-blue-500 transition cursor-pointer">
                                GR139235551
                            </button>
                            <button type="button" onclick="processBarcode('00999888')" class="text-xs font-mono px-2.5 py-1.5 rounded-lg card-alt hover:border-amber-500 transition cursor-pointer">
                                00999888 (Não cad.)
                            </button>
                        </div>
                    </div>
                </div>

                <!-- COLUNA DIREITA: RESULTADO DA IDENTIFICAÇÃO (7 cols) -->
                <div class="lg:col-span-7 flex flex-col">
                    <div id="identificationCard" class="card rounded-2xl p-6 sm:p-8 shadow-2xs flex-1 flex flex-col justify-between min-h-[320px]">

                        <!-- ESTADO INICIAL -->
                        <div id="stateIdle" class="my-auto text-center py-8 space-y-3">
                            <div class="w-16 h-16 rounded-2xl mx-auto flex items-center justify-center card-alt">
                                <i data-lucide="id-card" class="w-8 h-8" style="color: var(--accent);"></i>
                            </div>
                            <h2 class="text-lg sm:text-xl font-bold">Pronto para Identificar Colaborador</h2>
                            <p class="text-xs sm:text-sm max-w-md mx-auto" style="color: var(--text-secondary);">
                                Bipe o crachá com leitor USB/Bluetooth, use a câmera ou digite o código. Prefixos e zeros à esquerda são removidos automaticamente antes da consulta.
                            </p>
                        </div>

                        <!-- ESTADO ENCONTRADO -->
                        <div id="stateFound" class="hidden space-y-6">
                            <div class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b" style="border-color: var(--border-color);">
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-500 border border-emerald-500/30">
                                    <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                                    COLABORADOR IDENTIFICADO
                                </span>
                                <span id="foundTimestamp" class="text-xs font-mono" style="color: var(--text-muted);">--:--:--</span>
                            </div>

                            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
                                <div
                                    id="foundAvatar"
                                    class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl flex items-center justify-center text-xl sm:text-2xl font-extrabold text-white flex-shrink-0 btn-accent"
                                >
                                    GR
                                </div>
                                <div class="min-w-0 flex-1">
                                    <span class="text-[11px] font-bold uppercase tracking-wider" style="color: var(--text-muted);">Nome do Colaborador</span>
                                    <h2 id="foundName" class="text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight break-words mt-0.5">
                                        —
                                    </h2>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                <div class="card-alt p-4 rounded-xl">
                                    <span class="text-[11px] font-bold uppercase tracking-wider block" style="color: var(--text-muted);">Matrícula</span>
                                    <span id="foundMatricula" class="font-mono text-2xl font-extrabold mt-1 block" style="color: var(--accent);">—</span>
                                </div>
                                <div class="card-alt p-4 rounded-xl sm:col-span-2">
                                    <span class="text-[11px] font-bold uppercase tracking-wider block" style="color: var(--text-muted);">Função / Cargo</span>
                                    <span id="foundFuncao" class="text-lg sm:text-xl font-bold mt-1 block">—</span>
                                </div>
                            </div>

                            <div class="flex flex-wrap items-center justify-between gap-2 pt-2 text-xs" style="color: var(--text-secondary);">
                                <span class="flex items-center gap-1.5">
                                    <i data-lucide="map-pin" class="w-3.5 h-3.5"></i>
                                    Lotação / Setor: <strong id="foundLotacao" class="font-semibold">—</strong>
                                </span>
