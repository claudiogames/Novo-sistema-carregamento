    <script>
        /* =====================================================================
           CONFIGURAÇÕES PADRÃO (SUPABASE GRENDENE)
           ===================================================================== */
        const DEFAULT_SUPABASE_CONFIG = {
            url: 'https://dylwhnsxjbeiukdmcupq.supabase.co',
            key: 'sb_publishable_uZL-3Z0_a-X-ZjMhwRXC9w_RP8c754J',
            table: 'colaboradores',
            colMatricula: '',
            colNome: '',
            colFuncao: '',
            colLotacao: ''
        };

        const DEFAULT_PREFIX_CONFIG = {
            removeLetters: true,
            removeLeadingZeros: true,
            stripTrailingOne: true,
            normalizeEightDigits: true,
            customPrefixes: 'GR, CR',
            stripStart: 0,
            stripEnd: 0
        };

        const STORAGE_KEYS = {
            CONFIG: 'grendene_sb_config_v1',
            PREFIX: 'grendene_prefix_rules_v2',
            EMPLOYEES: 'grendene_employees_cache_v1',
            HISTORY: 'grendene_scan_history_v1',
            THEME: 'grendene_ui_theme_v1',
            SOUND: 'grendene_sound_enabled_v1'
        };

        let sbConfig = { ...DEFAULT_SUPABASE_CONFIG };
        let prefixRules = { ...DEFAULT_PREFIX_CONFIG };
        let supabaseClient = null;
        let supabaseSdkReady = false;
        let employees = [];
        let scanHistory = [];
        let autoFocus = true;
        let soundEnabled = true;

        // Estado da câmera ZXing
        let zxingReader = null;
        let activeStream = null;
        let activeVideoTrack = null;
        let torchEnabled = false;
        let isScanningCamera = false;
        let lastCameraCode = '';
        let lastCameraTime = 0;

        /* =====================================================================
           INICIALIZAÇÃO
           ===================================================================== */
        window.addEventListener('DOMContentLoaded', () => {
            loadSavedSettings();
            initSupabaseClient();
            lucide.createIcons();
            applyTheme(localStorage.getItem(STORAGE_KEYS.THEME) || 'light');
            updateSoundIcon();
            updatePrefixSummaryUI();
            renderEmployeesTable();
            renderHistoryTable();
            focusScanInput();

            // Mantém foco contínuo no campo de leitura para leitores USB/Bluetooth
            document.addEventListener('click', (event) => {
                if (!autoFocus) return;
                const bipTab = document.getElementById('view-bipador');
                if (!bipTab || bipTab.classList.contains('hidden')) return;
                if (!document.getElementById('configModal').classList.contains('hidden')) return;

                const target = event.target;
                if (target.closest('button, input, textarea, select, label, table, a')) return;
                focusScanInput();
            });

            // Garante resolução imediata do status no startup mesmo se o SDK demorar
            setSupabaseStatus('connecting', 'Supabase: Conectando...');
            syncFromSupabase(false);
        });

        function handleSupabaseSdkLoaded() {
            supabaseSdkReady = Boolean(window.supabase && window.supabase.createClient);
            initSupabaseClient();
        }

        function loadSupabaseSdkFallback() {
            if (document.getElementById('supabaseSdkFallbackScript')) return;
            const fallback = document.createElement('script');
            fallback.id = 'supabaseSdkFallbackScript';
            fallback.src = 'https://unpkg.com/@supabase/supabase-js@2/dist/umd/supabase.min.js';
            fallback.onload = () => {
                handleSupabaseSdkLoaded();
                syncFromSupabase(false);
            };
            fallback.onerror = () => {
                supabaseSdkReady = false;
                setSupabaseStatus('offline', 'Supabase: Fallback REST / Local');
            };
            document.head.appendChild(fallback);
        }

        function handleLogoError(imgEl) {
            imgEl.classList.add('hidden');
            const fallback = document.getElementById('grendeneLogoFallback');
            if (fallback) fallback.classList.remove('hidden');
        }

        function loadSavedSettings() {
            try {
                const rawCfg = localStorage.getItem(STORAGE_KEYS.CONFIG);
                if (rawCfg) sbConfig = { ...DEFAULT_SUPABASE_CONFIG, ...JSON.parse(rawCfg) };

                const rawPrefix = localStorage.getItem(STORAGE_KEYS.PREFIX);
                if (rawPrefix) prefixRules = { ...DEFAULT_PREFIX_CONFIG, ...JSON.parse(rawPrefix) };

                const rawEmp = localStorage.getItem(STORAGE_KEYS.EMPLOYEES);
                if (rawEmp) employees = JSON.parse(rawEmp);

                const rawHist = localStorage.getItem(STORAGE_KEYS.HISTORY);
                if (rawHist) scanHistory = JSON.parse(rawHist);

                const rawSound = localStorage.getItem(STORAGE_KEYS.SOUND);
                if (rawSound !== null) soundEnabled = JSON.parse(rawSound);
            } catch (err) {
                console.warn('Falha ao ler configurações locais:', err);
            }
            const badgeEl = document.getElementById('sourceModeBadge');
            if (badgeEl) {
                badgeEl.textContent = prefixRules.stripTrailingOne ? 'Padrão: 8 dígitos • -1 final' : `Supabase: ${sbConfig.table || 'colaboradores'}`;
            }
        }

        function initSupabaseClient() {
            const url = (sbConfig.url || DEFAULT_SUPABASE_CONFIG.url).trim();
            const key = (sbConfig.key || DEFAULT_SUPABASE_CONFIG.key).trim();
            if (!url || !key) {
                supabaseClient = null;
                return false;
            }
            if (window.supabase && typeof window.supabase.createClient === 'function') {
                try {
                    supabaseClient = window.supabase.createClient(url, key);
                    supabaseSdkReady = true;
                    return true;
                } catch (err) {
                    console.error('Erro ao inicializar cliente Supabase:', err);
                    supabaseClient = null;
                    return false;
                }
            }
