        function processBarcode(rawCode) {
            const rawStr = String(rawCode || '').trim();
            const cleanMatricula = cleanBarcodePrefix(rawStr);
            const now = new Date();
            const timeLabel = now.toLocaleTimeString('pt-BR');

            document.getElementById('rawCodeDisplay').textContent = rawStr || '—';
            document.getElementById('cleanCodeDisplay').textContent = cleanMatricula || '(vazio)';

            if (!cleanMatricula) {
                playBeep('error');
                showToast('Código vazio após remover prefixos.', 'warning');
                return;
            }

            const match = employees.find(
                (item) => cleanBarcodePrefix(item.matricula) === cleanMatricula || String(item.matricula).trim() === cleanMatricula
            );

            const card = document.getElementById('identificationCard');
            const stateIdle = document.getElementById('stateIdle');
            const stateFound = document.getElementById('stateFound');
            const stateNotFound = document.getElementById('stateNotFound');

            stateIdle.classList.add('hidden');
            card.classList.remove('flash-found', 'flash-warn');
            void card.offsetWidth;

            if (match) {
                stateNotFound.classList.add('hidden');
                stateFound.classList.remove('hidden');
                card.classList.add('flash-found');

                document.getElementById('foundTimestamp').textContent = `${now.toLocaleDateString('pt-BR')} • ${timeLabel}`;
                document.getElementById('foundName').textContent = match.nome;
                document.getElementById('foundMatricula').textContent = match.matricula;
                document.getElementById('foundFuncao').textContent = match.funcao || '—';
                document.getElementById('foundLotacao').textContent = match.lotacao || 'Não informada';

                const initials = match.nome
                    .split(/\s+/)
                    .filter(Boolean)
                    .slice(0, 2)
                    .map((p) => p[0])
                    .join('')
                    .toUpperCase();
                document.getElementById('foundAvatar').textContent = initials || 'GR';

                playBeep('success');
                vibrateSafe([65]);
                pushHistory({
                    time: timeLabel,
                    rawCode: rawStr,
                    matricula: match.matricula,
                    nome: match.nome,
                    funcao: match.funcao || '—',
                    found: true
                });
            } else {
                stateFound.classList.add('hidden');
                stateNotFound.classList.remove('hidden');
                card.classList.add('flash-warn');

                document.getElementById('notFoundTimestamp').textContent = timeLabel;
                document.getElementById('notFoundMatricula').textContent = cleanMatricula;
                document.getElementById('quickNomeInput').value = '';
                document.getElementById('quickFuncaoInput').value = '';
                document.getElementById('quickLotacaoInput').value = '';

                playBeep('error');
                vibrateSafe([110, 60, 110]);
                pushHistory({
                    time: timeLabel,
                    rawCode: rawStr,
                    matricula: cleanMatricula,
                    nome: 'NÃO CADASTRADO',
                    funcao: '—',
                    found: false
                });
            }
        }

