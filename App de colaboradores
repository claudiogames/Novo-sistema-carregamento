        function mapSupabaseRow(row) {
            if (!row || typeof row !== 'object') return null;

            const keys = Object.keys(row);
            const findKey = (explicitCol, candidates) => {
                if (explicitCol && keys.includes(explicitCol)) return explicitCol;
                if (explicitCol) {
                    const lowerExplicit = explicitCol.toLowerCase();
                    const foundExplicit = keys.find((k) => k.toLowerCase() === lowerExplicit);
                    if (foundExplicit) return foundExplicit;
                }
                for (const cand of candidates) {
                    const found = keys.find((k) => k.toLowerCase() === cand.toLowerCase());
                    if (found) return found;
                }
                for (const cand of candidates) {
                    const foundPartial = keys.find((k) => k.toLowerCase().includes(cand.toLowerCase()));
                    if (foundPartial) return foundPartial;
                }
                return null;
            };

            const matKey = findKey(sbConfig.colMatricula, ['matricula', 'matrícula', 'codigo', 'código', 'cracha', 'crachá', 'id']);
            const nomeKey = findKey(sbConfig.colNome, ['nome', 'colaborador', 'funcionario', 'funcionário']);
            const funcaoKey = findKey(sbConfig.colFuncao, ['funcao', 'função', 'cargo']);
            const lotacaoKey = findKey(sbConfig.colLotacao, ['lotacao', 'lotação', 'setor', 'turno', 'area', 'área']);

            const rawMat = matKey ? String(row[matKey] ?? '').trim() : '';
            const matricula = cleanBarcodePrefix(rawMat) || rawMat;
            const nome = nomeKey ? String(row[nomeKey] ?? '').trim().toUpperCase() : '';
            const funcao = funcaoKey ? String(row[funcaoKey] ?? '').trim() : '';
            const lotacao = lotacaoKey ? String(row[lotacaoKey] ?? '').trim() : '';

            if (!matricula || !nome) return null;
            return { matricula, nome, funcao, lotacao };
        }

        async function querySupabaseRows(tableName) {
            const url = (sbConfig.url || DEFAULT_SUPABASE_CONFIG.url).trim().replace(/\/+$/, '');
            const key = (sbConfig.key || DEFAULT_SUPABASE_CONFIG.key).trim();

            // 1. Tentativa via SDK oficial Supabase JS
            initSupabaseClient();
            if (supabaseClient) {
                const { data, error } = await supabaseClient
                    .from(tableName)
                    .select('*')
                    .limit(2000);

                if (!error && Array.isArray(data)) {
                    return { rows: data, via: 'SDK' };
                }

                // Se o erro for de coluna/tabela inexistente via SDK, tenta REST API antes de falhar
                console.warn('Consulta via SDK retornou erro, tentando REST API:', error);
                try {
                    const restRows = await querySupabaseViaRest(url, key, tableName);
                    return { rows: restRows, via: 'REST' };
                } catch (_) {
                    throw error || new Error('Falha ao consultar tabela no Supabase.');
                }
            }

            // 2. Fallback direto via PostgREST caso o SDK ainda não esteja disponível
            const restRows = await querySupabaseViaRest(url, key, tableName);
            return { rows: restRows, via: 'REST' };
        }

        async function querySupabaseViaRest(baseUrl, apiKey, tableName) {
            const endpoint = `${baseUrl}/rest/v1/${encodeURIComponent(tableName)}?select=*&limit=2000`;
            const response = await fetch(endpoint, {
                method: 'GET',
                headers: {
                    'apikey': apiKey,
                    'Authorization': `Bearer ${apiKey}`,
                    'Accept': 'application/json'
                }
            });

            if (!response.ok) {
                const errText = await response.text().catch(() => '');
                throw new Error(`HTTP ${response.status}: ${errText || response.statusText}`);
            }

            const json = await response.json();
            if (!Array.isArray(json)) {
                throw new Error('Resposta inesperada da API REST do Supabase.');
            }
            return json;
        }

        async function syncFromSupabase(showFeedback = false) {
            const tableName = (sbConfig.table || 'colaboradores').trim();
            setSupabaseStatus('connecting', 'Supabase: Conectando...');

            const timeoutGuard = setTimeout(() => {
                const currentText = document.getElementById('supabaseStatusText')?.textContent || '';
                if (currentText.includes('Conectando')) {
                    setSupabaseStatus('offline', `Supabase: Tempo esgotado (${employees.length} locais)`);
                }
            }, 8000);

            try {
                const { rows, via } = await querySupabaseRows(tableName);
                clearTimeout(timeoutGuard);

                const parsed = [];
                const seen = new Set();
                rows.forEach((row) => {
                    const mapped = mapSupabaseRow(row);
                    if (mapped && !seen.has(mapped.matricula)) {
                        seen.add(mapped.matricula);
                        parsed.push(mapped);
                    }
                });

                employees = parsed;
                localStorage.setItem(STORAGE_KEYS.EMPLOYEES, JSON.stringify(employees));
                renderEmployeesTable();
                hideSupabaseDiagnostic();
                setSupabaseStatus('connected', `Supabase: ${employees.length} colab. (${via})`);

                if (showFeedback) {
                    showToast(`Sincronizado com Supabase (${employees.length} colaboradores).`, 'success');
                }
                return { ok: true, count: employees.length };
            } catch (err) {
                clearTimeout(timeoutGuard);
                const msg = err?.message || String(err);
                console.error('Erro ao sincronizar com Supabase:', err);

                renderEmployeesTable();
                setSupabaseStatus('offline', `Supabase: Erro (${employees.length} locais)`);
                showSupabaseDiagnostic(
                    `Não foi possível carregar dados de "${tableName}" no Supabase`,
                    'Verifique se a tabela existe, se o RLS permite leitura pública (anon) e se a URL/chave estão corretas. Enquanto isso, o sistema opera com a base local salva.',
                    msg
                );

                if (showFeedback) {
                    showToast(`Falha no Supabase: ${msg}`, 'warning');
                }
                return { ok: false, error: msg };
            }
        }

        async function upsertEmployeeToSupabase(record) {
            const tableName = (sbConfig.table || 'colaboradores').trim();
            const matCol = (sbConfig.colMatricula || 'matricula').trim();
            const nomeCol = (sbConfig.colNome || 'nome').trim();
            const funcaoCol = (sbConfig.colFuncao || 'funcao').trim();
            const lotacaoCol = (sbConfig.colLotacao || 'lotacao').trim();

            const payload = {
                [matCol]: record.matricula,
                [nomeCol]: record.nome,
                [funcaoCol]: record.funcao
            };
            if (lotacaoCol) {
                payload[lotacaoCol] = record.lotacao || '';
            }

            try {
                initSupabaseClient();
                if (supabaseClient) {
                    const { error } = await supabaseClient
                        .from(tableName)
                        .upsert(payload, { onConflict: matCol });
                    if (error) throw error;
                    hideSupabaseDiagnostic();
                    setSupabaseStatus('connected', `Supabase: ${employees.length} colab.`);
                    return { ok: true };
                }

                const url = (sbConfig.url || DEFAULT_SUPABASE_CONFIG.url).trim().replace(/\/+$/, '');
                const key = (sbConfig.key || DEFAULT_SUPABASE_CONFIG.key).trim();
                const endpoint = `${url}/rest/v1/${encodeURIComponent(tableName)}?on_conflict=${encodeURIComponent(matCol)}`;
                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: {
                        'apikey': key,
                        'Authorization': `Bearer ${key}`,
                        'Content-Type': 'application/json',
                        'Prefer': 'resolution=merge-duplicates,return=minimal'
                    },
                    body: JSON.stringify(payload)
                });
                if (!res.ok) {
                    const txt = await res.text().catch(() => '');
                    throw new Error(`HTTP ${res.status}: ${txt || res.statusText}`);
                }
                hideSupabaseDiagnostic();
                setSupabaseStatus('connected', `Supabase: ${employees.length} colab.`);
                return { ok: true };
            } catch (err) {
                const msg = err?.message || String(err);
                return { ok: false, error: msg };
            }
        }

        async function deleteEmployeeFromSupabase(matricula) {
            const tableName = (sbConfig.table || 'colaboradores').trim();
            const matCol = (sbConfig.colMatricula || 'matricula').trim();
            try {
                initSupabaseClient();
                if (supabaseClient) {
                    const { error } = await supabaseClient
                        .from(tableName)
                        .delete()
                        .eq(matCol, matricula);
                    if (error) throw error;
                }
                return { ok: true };
            } catch (err) {
                console.warn('Falha ao excluir no Supabase:', err);
                return { ok: false, error: err?.message || String(err) };
            }
        }

        /* =====================================================================
           REMOÇÃO DE PREFIXOS E NORMALIZAÇÃO PADRÃO 8 DÍGITOS
           ===================================================================== */
        function cleanBarcodePrefix(rawCode) {
            if (rawCode === null || rawCode === undefined) return '';
            let code = String(rawCode).trim().toUpperCase();
            if (!code) return '';

            // 1. Prefixos customizados configurados no início (ex.: GR, CR, 00)
            if (prefixRules.customPrefixes && prefixRules.customPrefixes.trim()) {
                const prefixes = prefixRules.customPrefixes
                    .split(',')
                    .map((p) => p.trim().toUpperCase())
                    .filter(Boolean)
                    .sort((a, b) => b.length - a.length);

                for (const prefix of prefixes) {
                    if (code.startsWith(prefix)) {
                        code = code.slice(prefix.length);
                        break;
                    }
                }
            }

            // 2. Corte fixo no início
            const stripStart = Math.max(0, parseInt(prefixRules.stripStart, 10) || 0);
            if (stripStart > 0 && code.length > stripStart) {
                code = code.slice(stripStart);
            }

            // 3. Corte fixo no final
            const stripEnd = Math.max(0, parseInt(prefixRules.stripEnd, 10) || 0);
            if (stripEnd > 0 && code.length > stripEnd) {
                code = code.slice(0, -stripEnd);
            }

            // 4. Remover letras e símbolos (mantém apenas dígitos quando ativo)
            if (prefixRules.removeLetters) {
                code = code.replace(/[^0-9]/g, '');
            } else {
                code = code.replace(/\s+/g, '');
            }

            // 5. Remover sufixo "1" residual quando excede 8 dígitos ou termina em "1" após 8 dígitos
            if (prefixRules.stripTrailingOne && /^[0-9]+$/.test(code)) {
                if (code.length > 8 && code.endsWith('1')) {
                    code = code.slice(0, -1);
                }
            }

            // 6. Normalizar para o padrão de 8 dígitos da Grendene (ex.: 13932290)
            if (prefixRules.normalizeEightDigits && /^[0-9]+$/.test(code)) {
                if (code.length > 8) {
                    // Se o último dígito for '1' e os primeiros 8 formarem a matrícula, prioriza os 8 primeiros
                    if (code.endsWith('1')) {
                        code = code.slice(0, 8);
                    } else {
                        code = code.slice(-8);
                    }
                }
            }

            // 7. Remover zeros à esquerda apenas se não reduzir abaixo do necessário ou quando não for 8 dígitos exatos
            if (prefixRules.removeLeadingZeros && code.length > 1 && !(prefixRules.normalizeEightDigits && code.length === 8)) {
                code = code.replace(/^0+/, '') || '0';
            }

            return code;
        }

        function updatePrefixSummaryUI() {
            const parts = [];
            if (prefixRules.normalizeEightDigits) parts.push('8 dígitos');
            if (prefixRules.stripTrailingOne) parts.push('Sem "1" final');
            if (prefixRules.customPrefixes && prefixRules.customPrefixes.trim()) {
                parts.push(prefixRules.customPrefixes.trim());
            }
            if (prefixRules.removeLetters) parts.push('Só números');
            if (prefixRules.removeLeadingZeros) parts.push('Sem zeros à esq.');
            if ((parseInt(prefixRules.stripStart, 10) || 0) > 0) parts.push(`-${prefixRules.stripStart} iníc.`);
            if ((parseInt(prefixRules.stripEnd, 10) || 0) > 0) parts.push(`-${prefixRules.stripEnd} fim`);

            const summary = parts.length > 0 ? parts.join(' • ') : 'Sem filtro';
            const el = document.getElementById('activePrefixSummary');
            if (el) el.textContent = summary;

            const badgeEl = document.getElementById('sourceModeBadge');
            if (badgeEl) {
                badgeEl.textContent = prefixRules.stripTrailingOne
                    ? 'Padrão: 8 dígitos • -1 final'
                    : `Supabase: ${sbConfig.table || 'colaboradores'}`;
            }
        }

