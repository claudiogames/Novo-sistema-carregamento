                { id: 'OC-110', cliente: 'Sol Nascente - RN', prazo: 'Hoje - Tarde', caixas: 600,  pallets: 3, minutosTurno: 15, duracaoRealSeg: 300 },
                { id: 'OC-111', cliente: 'Centro Oeste - MT', prazo: 'Amanhã', caixas: 1000, pallets: 5, minutosTurno: 24, duracaoRealSeg: 420 },
                { id: 'OC-112', cliente: 'Vale Verde - SC', prazo: 'Amanhã', caixas: 800,  pallets: 4, minutosTurno: 19, duracaoRealSeg: 300 },
