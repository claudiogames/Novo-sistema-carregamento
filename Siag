                for (var b = 0; b < btnsIni.length; b++) {
                    btnsIni[b].addEventListener('click', function(ev) {
                        ev.stopPropagation();
                        iniciarCarregamentoImediato(this.getAttribute('data-iniciar-id'));
                    });
                }

                var btnsRem = tbody.querySelectorAll('button[data-remover-id]');
                for (var c = 0; c < btnsRem.length; c++) {
                    btnsRem[c].addEventListener('click', function(ev) {
                        ev.stopPropagation();
                        removerOrdemDoSistema(this.getAttribute('data-remover-id'));
                    });
                }
            }

            function renderizarVisualizacao12() {
                var strip = document.getElementById('grid-portoes-12');
                var stripHtml = '';

                for (var p = 1; p <= 12; p++) {
                    var pStr = p < 10 ? '0' + p : '' + p;
                    var slots = estadoPortoes[p].slots;

                    var temPreparo = false;
                    var temCarregando = false;
                    var todasFechadas = slots.length > 0;
                    var paresP = 0;

                    for (var s = 0; s < slots.length; s++) {
                        var sl = slots[s];
                        paresP += sl.pares;
                        var stOrd = ordensEmExecucao[sl.ordemId];
                        if (stOrd) {
                            if (stOrd.fase === 'PREPARO') temPreparo = true;
                            if (stOrd.fase === 'CARREGANDO') temCarregando = true;
                            if (stOrd.fase !== 'FECHADA') todasFechadas = false;
                        }
                    }

                    var cls = 'portao-12-btn portao-livre';
                    var rotuloEstado = 'Livre';
                    if (slots.length > 0) {
                        if (temPreparo) {
                            cls = 'portao-12-btn portao-preparo';
                            rotuloEstado = 'Preparo';
                        } else if (temCarregando) {
                            cls = 'portao-12-btn portao-carregando';
                            rotuloEstado = 'Carregando';
                        } else if (todasFechadas) {
                            cls = 'portao-12-btn portao-fechado';
                            rotuloEstado = 'Fechado';
                        }
                    }
                    if (portaoAtivo === p) cls += ' selecionado';

                    stripHtml += '<button type="button" data-portao-12="' + p + '" class="' + cls + '">' +
                        '<span>PT ' + pStr + '</span>' +
                        '<span style="font-size:9px;">' + slots.length + '/22 pal • ' + rotuloEstado + '</span>' +
                        '<span style="font-size:9px;">' + (paresP > 0 ? formatarNumero(paresP) + ' pares' : '-') + '</span>' +
                    '</button>';
                }
                strip.innerHTML = stripHtml;

                var pBtns = strip.querySelectorAll('button[data-portao-12]');
                for (var i = 0; i < pBtns.length; i++) {
                    pBtns[i].addEventListener('click', function() {
                        var escolhido = Number(this.getAttribute('data-portao-12'));
                        portaoAtivo = escolhido;
                        portaoDestinoSelecionado = escolhido;
                        filtroSlotAtivo = null;
                        sincronizarOpcoesPortoes12();
                        renderizarVisualizacao12();
                        renderizarTabelaProgramacao();
                    });
                }

                var dadosP = estadoPortoes[portaoAtivo];
                var atStr = portaoAtivo < 10 ? '0' + portaoAtivo : '' + portaoAtivo;

                var ocupMap = {};
                var paresTotal = 0;
                var caixasTotal = 0;
                var minTurnoTotal = 0;
                var ocsSet = {};

                for (var k = 0; k < dadosP.slots.length; k++) {
                    var it = dadosP.slots[k];
                    ocupMap[it.coluna + '-' + it.pos] = it;
                    paresTotal += it.pares;
                    caixasTotal += it.caixas;
                    minTurnoTotal += it.minutosTurno;
                    ocsSet[it.ordemId] = true;
                }

                var listaOCs = Object.keys(ocsSet);
                document.getElementById('titulo-portao-detalhe').textContent =
                    'Portão ' + atStr + (listaOCs.length > 0 ? ' — Ordens: ' + listaOCs.join(', ') : ' — Livre');

                document.getElementById('metricas-portao-detalhe').textContent =
                    'Pallets: ' + dadosP.slots.length + ' / ' + MAX_PALLETS_PORTAO +
                    ' • Pares: ' + formatarNumero(paresTotal) +
                    ' • Caixas: ' + formatarNumero(caixasTotal) +
                    ' • Turno: ' + formatarTempoTurno(minTurnoTotal);

                var c1Html = '';
                var c2Html = '';
                for (var pos = 1; pos <= 11; pos++) {
                    var occ1 = !!ocupMap['Col 1-' + pos];
                    var occ2 = !!ocupMap['Col 2-' + pos];
                    var sel1 = filtroSlotAtivo === 'Col 1-' + pos ? ' pos-selecionada' : '';
                    var sel2 = filtroSlotAtivo === 'Col 2-' + pos ? ' pos-selecionada' : '';

                    c1Html += '<button type="button" data-slot="Col 1-' + pos + '" class="pos-btn ' + (occ1 ? 'pos-ocupada' : 'pos-livre') + sel1 + '">' + pos + '</button>';
                    c2Html += '<button type="button" data-slot="Col 2-' + pos + '" class="pos-btn ' + (occ2 ? 'pos-ocupada' : 'pos-livre') + sel2 + '">' + pos + '</button>';
                }
                document.getElementById('mapa-col1').innerHTML = c1Html;
                document.getElementById('mapa-col2').innerHTML = c2Html;

                var slotBtns = document.querySelectorAll('button[data-slot]');
                for (var sIdx = 0; sIdx < slotBtns.length; sIdx++) {
                    slotBtns[sIdx].addEventListener('click', function() {
                        var chave = this.getAttribute('data-slot');
                        filtroSlotAtivo = (filtroSlotAtivo === chave) ? null : chave;
                        renderizarVisualizacao12();
                    });
                }

                var filtrados = [];
                for (var r = 0; r < dadosP.slots.length; r++) {
                    var reg = dadosP.slots[r];
                    if (!filtroSlotAtivo || (reg.coluna + '-' + reg.pos) === filtroSlotAtivo) {
                        filtrados.push(reg);
                    }
                }

                var tbody = document.getElementById('tbody-portao-detalhe');
                if (filtrados.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="9" style="padding:14px; color:#64748b;">Nenhum pallet alocado nesta visão do Portão ' + atStr + '.</td></tr>';
                    return;
                }

                var rowsHtml = '';
                for (var j = 0; j < filtrados.length; j++) {
                    var item = filtrados[j];
                    var stOrd = ordensEmExecucao[item.ordemId];
                    var pct = 0;
                    var stHtml = '<span class="badge badge-aguardando">Aguardando</span>';
                    var barCls = 'mini-prog-bar';

                    if (stOrd) {
                        if (stOrd.fase === 'PREPARO') {
                            pct = 0;
                            stHtml = '<span class="badge badge-preparo">Preparo ' + formatarMMSS(stOrd.preparoRestanteSeg) + '</span>';
                            barCls = 'mini-prog-bar preparo';
                        } else if (stOrd.fase === 'CARREGANDO') {
                            pct = Math.round(stOrd.progresso * 100);
                            stHtml = '<span class="badge badge-carregando">Carregando</span>';
                        } else if (stOrd.fase === 'FECHADA') {
                            pct = 100;
                            stHtml = '<span class="badge badge-fechada">Fechada</span>';
                            barCls = 'mini-prog-bar fechada';
                        }
                    }

                    var badgeCol = item.coluna === 'Col 2'
                        ? '<span style="background:#38a86b; color:#fff; padding:1px 6px; border-radius:9px; font-size:10px; font-weight:700;">Col 2</span>'
                        : '<span style="background:#2d74b8; color:#fff; padding:1px 6px; border-radius:9px; font-size:10px; font-weight:700;">Col 1</span>';

                    rowsHtml += '<tr>' +
                        '<td style="font-family:monospace; font-weight:700;">' + String(item.pos).padStart(2, '0') + '</td>' +
                        '<td>' + badgeCol + '</td>' +
                        '<td style="font-family:monospace; font-weight:700; color:#1d4ed8;">' + item.ordemId + '</td>' +
                        '<td style="background:#ef4444; color:#fff; font-family:monospace; font-weight:700;">' + item.palletCod + '</td>' +
                        '<td style="font-family:monospace; font-weight:700;">' + formatarNumero(item.pares) + '</td>' +
                        '<td style="font-family:monospace;">' + formatarNumero(item.caixas) + '</td>' +
                        '<td>' + stHtml + '</td>' +
                        '<td style="white-space:nowrap;">' +
                            '<div class="mini-prog-wrap"><div class="' + barCls + '" style="width:' + pct + '%;"></div></div>' +
                            '<span style="font-family:monospace; font-size:10px; font-weight:700;">' + pct + '%</span>' +
                        '</td>' +
                        '<td><button type="button" data-tirar-oc="' + item.ordemId + '" style="background:#dc2626; color:#fff; border:none; padding:2px 6px; border-radius:2px; cursor:pointer; font-size:10px;">Tirar OC</button></td>' +
                    '</tr>';
                }
                tbody.innerHTML = rowsHtml;

                var tirarBtns = tbody.querySelectorAll('button[data-tirar-oc]');
                for (var tb = 0; tb < tirarBtns.length; tb++) {
                    tirarBtns[tb].addEventListener('click', function() {
                        removerOrdemDoSistema(this.getAttribute('data-tirar-oc'));
                    });
                }
            }

            function abrirAba(aba, fecharMenu) {
                document.getElementById('aba-programacao').style.display = 'none';
                document.getElementById('aba-visualizacao').style.display = 'none';
                document.getElementById('tab-programacao').classList.remove('ativa');
                document.getElementById('tab-visualizacao').classList.remove('ativa');

                if (aba === 'programacao') {
                    document.getElementById('aba-programacao').style.display = 'block';
                    document.getElementById('tab-programacao').classList.add('ativa');
                    document.getElementById('header-title').textContent = 'Programação & Sequenciamento — 1 min Preparo + Ciclo Real';
                } else {
                    document.getElementById('aba-visualizacao').style.display = 'block';
                    document.getElementById('tab-visualizacao').classList.add('ativa');
                    document.getElementById('header-title').textContent = 'Visualização do Carregamento — 12 Portões';
                }

                if (fecharMenu) {
                    document.getElementById('sidebar').classList.add('collapsed');
                }
                atualizarTela();
            }

            function atualizarTela() {
                var ind = calcularIndicadores();
                renderizarKPIs(ind);
                sincronizarOpcoesPortoes12();
                renderizarTabelaProgramacao();
                renderizarVisualizacao12();
            }

            // Listeners
            document.getElementById('btn-toggle-sidebar').addEventListener('click', function() {
                document.getElementById('sidebar').classList.toggle('collapsed');
            });

            var abasEls = document.querySelectorAll('[data-aba]');
            for (var a = 0; a < abasEls.length; a++) {
                abasEls[a].addEventListener('click', function() {
                    var dest = this.getAttribute('data-aba');
                    var fechar = this.tagName === 'LI';
                    abrirAba(dest, fechar);
                });
            }

            document.getElementById('select-portao-destino').addEventListener('change', function() {
                portaoDestinoSelecionado = Number(this.value) || 1;
                portaoAtivo = portaoDestinoSelecionado;
                renderizarTabelaProgramacao();
            });

            document.getElementById('filtro-prazo').addEventListener('change', renderizarTabelaProgramacao);

            document.getElementById('btn-alocar-selecionada').addEventListener('click', function() {
                alocarOrdemNoPortao(ordemSelecionadaId, portaoDestinoSelecionado);
            });

            document.getElementById('btn-ir-visualizacao').addEventListener('click', function() {
                portaoAtivo = portaoDestinoSelecionado;
                abrirAba('visualizacao', false);
            });

            document.getElementById('btn-voltar-programacao').addEventListener('click', function() {
                portaoDestinoSelecionado = portaoAtivo;
                sincronizarOpcoesPortoes12();
                abrirAba('programacao', false);
            });

            document.getElementById('btn-desalocar-portao').addEventListener('click', function() {
                liberarPortao(portaoAtivo);
            });

            document.getElementById('btn-reset-simulacao').addEventListener('click', function() {
                inicializarEstado();
                ordemSelecionadaId = 'OC-101';
                portaoDestinoSelecionado = 1;
                portaoAtivo = 1;
                filtroSlotAtivo = null;
                mostrarAviso('Simulação reiniciada');
                atualizarTela();
            });

            inicializarEstado();
            atualizarTela();
            setInterval(tickSegundos, 1000);
        })();
    </script>
</body>
</html>
