<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIAG - Programação e Visualização do Carregamento</title>
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #d6dce7;
            color: #1e293b;
            margin: 0;
            overflow-x: hidden;
        }
        .siag-header {
            background-color: #2f3b52;
            color: #ffffff;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 12px;
        }
        .siag-subbar {
            background-color: #263146;
            color: #cbd5e1;
            font-size: 11px;
            padding: 5px 12px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            border-bottom: 1px solid #1e2738;
        }
        .tabs-barra {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 4px;
        }
        .tab-btn {
            background-color: #344463;
            color: #e2e8f0;
            border: 1px solid #485d85;
            border-radius: 2px;
            padding: 4px 12px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }
        .tab-btn:hover {
            background-color: #41557a;
            color: #ffffff;
        }
        .tab-btn.ativa {
            background-color: #38a86b;
            border-color: #2e8f59;
            color: #ffffff;
        }
        .siag-sidebar {
            background-color: #2c66a8;
            color: #ffffff;
            width: 245px;
            flex-shrink: 0;
            transition: width 0.2s ease;
        }
        .siag-sidebar.collapsed {
            width: 0;
            overflow: hidden;
        }
        .siag-sidebar-header {
            background-color: #22538c;
            padding: 12px;
            text-align: center;
            font-size: 11px;
            font-weight: 700;
            line-height: 1.3;
        }
        .siag-menu-item {
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 11px;
            font-weight: 600;
            padding: 8px 12px;
            cursor: pointer;
        }
        .siag-menu-item:hover {
            background-color: #1e4b7e;
        }
        .painel-box {
            background-color: #e8ecf4;
            border: 1px solid #b5c0d1;
            margin-bottom: 10px;
        }
        .siag-panel-bar {
            background-color: #344463;
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
            padding: 6px 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .campo-label {
            display: block;
            font-size: 11px;
            color: #334155;
            margin-bottom: 3px;
            font-weight: 600;
        }
        .siag-input {
            width: 100%;
            background-color: #ffffff;
            border: 1px solid #b5c0d1;
            border-radius: 2px;
            padding: 5px 8px;
            font-size: 12px;
            color: #1e293b;
            outline: none;
        }
        .siag-input:focus {
            border-color: #2d74b8;
        }
        .grid-prog-topo {
            display: grid;
            grid-template-columns: repeat(4, minmax(140px, 1fr));
            gap: 10px 14px;
        }
        .grid-prog-item {
            display: grid;
            grid-template-columns: repeat(6, minmax(110px, 1fr));
            gap: 8px 10px;
            align-items: end;
        }
        @media (max-width: 960px) {
            .grid-prog-item {
                grid-template-columns: repeat(2, minmax(120px, 1fr));
            }
        }
        @media (max-width: 720px) {
            .grid-prog-topo {
                grid-template-columns: repeat(2, minmax(130px, 1fr));
            }
        }
        .btn-azul {
            background-color: #2d74b8;
            color: #ffffff;
            border: 1px solid #225a91;
            border-radius: 2px;
            padding: 6px 12px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-azul:hover {
            background-color: #225a91;
        }
        .btn-verde {
            background-color: #38a86b;
            color: #ffffff;
            border: 1px solid #2b8754;
            border-radius: 2px;
            padding: 7px 14px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
        }
        .btn-verde:hover {
            background-color: #2e8f59;
        }
        .btn-neutro {
            background-color: #cbd5e1;
            color: #1e293b;
            border: 1px solid #94a3b8;
            border-radius: 2px;
            padding: 6px 12px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-neutro:hover {
            background-color: #b8c4d4;
        }
        .siag-table {
            width: 100%;
            border-collapse: collapse;
            background-color: #ffffff;
        }
        .siag-table th {
            background-color: #2d74b8;
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            padding: 6px 8px;
            border-right: 1px solid #5995ce;
            text-align: center;
        }
        .siag-table td {
            font-size: 11px;
            padding: 5px 8px;
            border-bottom: 1px solid #cbd5e1;
            text-align: center;
        }
        .portoes-wrapper {
            background: #e8ecf4;
            border: 1px solid #cbd5e1;
            padding: 6px;
            margin-bottom: 8px;
            overflow-x: auto;
        }
        .portoes-strip {
            display: flex;
            width: 100%;
            min-width: 900px;
            border: 1px solid #9aa4b2;
        }
        .portao-btn {
            flex: 1 0 30px;
            height: 40px;
            border: none;
            border-right: 1px solid #9aa4b2;
            font-size: 11px;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 0;
        }
        .portao-btn:last-child {
            border-right: none;
        }
        .portao-livre {
            background-color: #e5e7eb;
            color: #475569;
        }
        .portao-bloqueado {
            background-color: #9ca3af;
            color: #1e293b;
        }
        .portao-programado {
            background-color: #38a86b;
            color: #ffffff;
            font-weight: 700;
        }
        .portao-btn.selecionado {
            box-shadow: inset 0 0 0 2px #1d4ed8;
            font-weight: 800;
        }
        .pos-btn {
            display: block;
            width: 44px;
            padding: 4px 0;
            margin-bottom: 3px;
            font-size: 10px;
            font-weight: 700;
            text-align: center;
            cursor: pointer;
        }
        .pos-ocupada {
            background-color: #ef4444;
            color: #ffffff;
            border: 1px solid #b91c1c;
        }
        .pos-livre {
            background-color: #e2e8f0;
            color: #475569;
            border: 1px solid #94a3b8;
        }
    </style>
</head>
<body>

    <!-- CABEÇALHO SUPERIOR -->
    <header class="siag-header">
        <div style="display:flex; align-items:center; gap:12px;">
            <button type="button" id="btn-toggle-sidebar" style="background:none; border:none; color:white; font-size:18px; cursor:pointer;" title="Menu">☰</button>
            <span id="header-title" style="font-size:14px; font-weight:600; letter-spacing:0.3px;">
                Programação de Carregamento
            </span>
        </div>

        <div style="font-size:12px; color:#e2e8f0;">
            Benilo Araujo Carneiro ▼
        </div>
    </header>

    <!-- BARRA DE GUIAS -->
    <nav class="siag-subbar">
        <div class="tabs-barra">
            <button type="button" id="tab-programacao" data-aba="programacao" class="tab-btn ativa">Programação</button>
            <button type="button" id="tab-visualizacao" data-aba="visualizacao" class="tab-btn">Visualização do Carregamento</button>
        </div>
        <div id="status-aviso" style="font-size:11px; color:#86efac; font-weight:600;"></div>
    </nav>

    <!-- CORPO PRINCIPAL -->
    <div style="display:flex; min-height:calc(100vh - 70px);">

        <!-- BARRA LATERAL -->
        <aside id="sidebar" class="siag-sidebar collapsed">
            <div class="siag-sidebar-header">
                SISTEMA INTEGRADO DE<br>ARMAZENAGEM GRENDENE
            </div>

            <div style="padding:8px; background:#3372b8;">
                <input type="text" id="menu-search" placeholder="Pesquisar" style="width:100%; padding:4px 8px; font-size:12px; color:#1e293b; border:none; border-radius:2px;">
            </div>

            <ul id="sidebar-menu-list" style="list-style:none; margin:0; padding:0;">
                <li data-aba="programacao" class="siag-menu-item">+ PROGRAMAÇÃO</li>
                <li data-aba="visualizacao" class="siag-menu-item">+ VISUALIZAÇÃO DO CARREGAMENTO</li>
                <li data-aba="visualizacao" class="siag-menu-item">+ GESTÃO VISUAL DE VEÍCULOS</li>
                <li data-aba="visualizacao" class="siag-menu-item">+ EXPEDIÇÃO</li>
            </ul>
        </aside>

        <!-- ÁREA PRINCIPAL -->
        <main style="flex:1; padding:8px; overflow-x:hidden;">

            <!-- =================================================================== -->
            <!-- ABA 1: PROGRAMAÇÃO                                                  -->
            <!-- =================================================================== -->
            <section id="aba-programacao">
                <div class="painel-box">
                    <div class="siag-panel-bar">
                        <span>Programar Ordem de Carregamento</span>
                        <span style="font-size:11px; color:#cbd5e1;">Envia direto para a Visualização do Carregamento</span>
                    </div>

                    <div style="padding:12px;">
                        <!-- Cabeçalho da Programação -->
                        <div class="grid-prog-topo" style="margin-bottom:14px;">
                            <div>
                                <label class="campo-label">Ordem de Carregamento (OC)</label>
                                <input type="text" id="prog-oc" placeholder="Ex: 11122954" class="siag-input">
                            </div>

                            <div>
                                <label class="campo-label">Portão (01 a 30)</label>
                                <select id="prog-portao" class="siag-input"></select>
                            </div>

                            <div>
                                <label class="campo-label">Setor de Trabalho</label>
                                <select id="prog-setor" class="siag-input">
                                    <option value="4 - Expedição" selected>4 - Expedição</option>
                                    <option value="1 - Recebimento">1 - Recebimento</option>
                                    <option value="2 - Pulmão Sorter">2 - Pulmão Sorter</option>
                                </select>
                            </div>

                            <div>
                                <label class="campo-label">Transportadora / Observação</label>
                                <input type="text" id="prog-obs" placeholder="Opcional" class="siag-input">
                            </div>
                        </div>

                        <!-- Adicionar Itens / Pallets da Ordem -->
                        <div style="border-top:1px solid #b5c0d1; padding-top:12px; margin-bottom:12px;">
                            <div style="font-size:11px; font-weight:700; color:#274a7a; margin-bottom:8px;">
                                Adicionar Pallet / Posição na Ordem
                            </div>

                            <div class="grid-prog-item">
                                <div>
                                    <label class="campo-label">Lado</label>
                                    <select id="prog-lado" class="siag-input">
                                        <option value="L1">L1 (Lado 1)</option>
                                        <option value="L2">L2 (Lado 2)</option>
                                    </select>
                                </div>

                                <div>
                                    <label class="campo-label">Posição (Px 01..11)</label>
                                    <input type="text" id="prog-px" placeholder="01" class="siag-input">
                                </div>

                                <div>
                                    <label class="campo-label">Pallet</label>
                                    <input type="text" id="prog-pallet" placeholder="Nº Pallet" class="siag-input">
                                </div>

                                <div>
                                    <label class="campo-label">Lote</label>
                                    <input type="text" id="prog-lote" placeholder="Lote" class="siag-input">
                                </div>

                                <div>
                                    <label class="campo-label">Box</label>
                                    <input type="text" id="prog-box" placeholder="Box" class="siag-input">
                                </div>

                                <div>
                                    <label class="campo-label">Caixas</label>
                                    <input type="number" id="prog-caixas" min="1" placeholder="Qtd" class="siag-input">
                                </div>
                            </div>

                            <div style="margin-top:10px; display:flex; flex-wrap:wrap; gap:8px;">
                                <button type="button" id="btn-add-item-prog" class="btn-azul">+ Incluir na Lista</button>
                                <button type="button" id="btn-limpar-prog" class="btn-neutro">Limpar Tudo</button>
                            </div>
                        </div>

                        <!-- Prévia da Ordem a ser Enviada -->
                        <div style="border:1px solid #b5c0d1; background:#ffffff; overflow-x:auto; margin-bottom:12px;">
                            <table class="siag-table">
                                <thead>
                                    <tr>
                                        <th>Portão</th>
                                        <th>OC</th>
                                        <th>Px</th>
                                        <th>Lado</th>
                                        <th>Pallet</th>
                                        <th>Lote</th>
                                        <th>Box</th>
                                        <th>Caixas</th>
                                        <th>Ação</th>
                                    </tr>
                                </thead>
                                <tbody id="tbody-fila-programacao">
                                    <tr>
                                        <td colspan="9" style="padding:14px; color:#64748b;">
                                            Nenhum item adicionado ainda. Preencha os campos acima ou envie a OC direto para o portão.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Ação Principal: Enviar para Visualização do Carregamento -->
                        <div style="display:flex; flex-wrap:wrap; justify-content:flex-end; gap:8px;">
                            <button type="button" id="btn-enviar-carregamento" class="btn-verde">
                                Enviar para Visualização do Carregamento ▶
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- =================================================================== -->
            <!-- ABA 2: VISUALIZAÇÃO DO CARREGAMENTO                                -->
            <!-- =================================================================== -->
            <section id="aba-visualizacao" style="display:none;">
                <div style="background:#e8ecf4; border:1px solid #cbd5e1; padding:8px 10px; margin-bottom:8px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px; font-size:12px;">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span style="font-weight:600; color:#334155;">Setor de Trabalho</span>
                        <select id="select-setor" class="siag-input" style="width:170px;">
                            <option value="4 - Expedição" selected>4 - Expedição</option>
                            <option value="1 - Recebimento">1 - Recebimento</option>
                            <option value="2 - Pulmão Sorter">2 - Pulmão Sorter</option>
                        </select>
                        <button type="button" id="btn-refresh-cd" class="btn-azul">↻</button>
                    </div>

                    <div style="display:flex; align-items:center; gap:8px;">
                        <button type="button" id="btn-voltar-programacao" class="btn-azul">+ Nova Programação</button>
                        <button type="button" id="btn-limpar-portao-atual" class="btn-neutro">Limpar Portão</button>
                    </div>
                </div>

                <!-- FAIXA DE PORTÕES 01 A 30 -->
                <div class="portoes-wrapper">
                    <div id="grid-portoes" class="portoes-strip"></div>
                </div>

                <!-- MAPA LADO 1 / LADO 2 + GRADE DO PORTÃO -->
                <div style="background:#e8ecf4; border:1px solid #cbd5e1; padding:10px; display:flex; flex-wrap:wrap; gap:16px;">
                    <div style="display:flex; gap:10px;">
                        <div>
                            <div style="background:#2d74b8; color:white; font-size:10px; font-weight:700; padding:4px 8px; text-align:center; margin-bottom:4px;">Lado 1</div>
                            <div id="mapa-lado1"></div>
                        </div>
                        <div>
                            <div style="background:#38a86b; color:white; font-size:10px; font-weight:700; padding:4px 8px; text-align:center; margin-bottom:4px;">Lado 2</div>
                            <div id="mapa-lado2"></div>
                        </div>
                    </div>

                    <div style="flex:1; min-width:300px;">
                        <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px; margin-bottom:8px;">
                            <div id="titulo-portao-ativo" style="font-size:12px; font-weight:700; color:#1e293b;">
                                Portão 01 - Ordem de carregamento: -
                            </div>
                            <div id="resumo-portao-ativo" style="font-size:11px; font-weight:600; color:#334155;"></div>
                        </div>

                        <div style="overflow-x:auto; border:1px solid #cbd5e1; background:#ffffff;">
                            <table class="siag-table">
                                <thead>
                                    <tr>
                                        <th>Px</th>
                                        <th>Pallet</th>
                                        <th>Lote</th>
                                        <th>Box</th>
                                        <th>Endereço</th>
                                        <th>Caixas</th>
                                        <th>Atividade</th>
                                        <th>Operador</th>
                                    </tr>
                                </thead>
                                <tbody id="tbody-portao-pallets">
                                    <tr>
                                        <td colspan="8" style="padding:16px; color:#64748b;">
                                            Nenhuma ordem programada neste portão. Vá na aba Programação para enviar uma ordem.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

        </main>
    </div>

    <script>
        (function() {
            var memoriaTemp = {};

            function lerStorage(chave) {
                try {
                    if (window.localStorage) {
                        var raw = window.localStorage.getItem(chave);
                        if (raw) return JSON.parse(raw);
                    }
                } catch (e) {}
                return memoriaTemp[chave] || null;
            }

            function gravarStorage(chave, valor) {
                memoriaTemp[chave] = valor;
                try {
                    if (window.localStorage) {
                        window.localStorage.setItem(chave, JSON.stringify(valor));
                    }
                } catch (e) {}
            }

            var STORAGE_KEY = 'siag_programacao_carregamento_v1';
            var estadoSistema = lerStorage(STORAGE_KEY) || {
                portaoAtivo: 1,
                portoes: {}
            };

            var filaProgramacao = [];

            function popularSelectPortoes() {
                var sel = document.getElementById('prog-portao');
                var html = '';
                for (var i = 1; i <= 30; i++) {
                    var num = i < 10 ? '0' + i : '' + i;
                    html += '<option value="' + i + '">Portão ' + num + '</option>';
                }
                sel.innerHTML = html;
                sel.value = String(estadoSistema.portaoAtivo || 1);
            }

            function mostrarAviso(msg) {
                var el = document.getElementById('status-aviso');
                el.textContent = msg;
                setTimeout(function() {
                    if (el.textContent === msg) el.textContent = '';
                }, 4000);
            }

            function abrirAba(aba, fecharMenu) {
                document.getElementById('aba-programacao').style.display = 'none';
                document.getElementById('aba-visualizacao').style.display = 'none';

                document.getElementById('tab-programacao').classList.remove('ativa');
                document.getElementById('tab-visualizacao').classList.remove('ativa');

                if (aba === 'programacao') {
                    document.getElementById('aba-programacao').style.display = 'block';
                    document.getElementById('tab-programacao').classList.add('ativa');
                    document.getElementById('header-title').textContent = 'Programação de Carregamento';
                } else {
                    document.getElementById('aba-visualizacao').style.display = 'block';
                    document.getElementById('tab-visualizacao').classList.add('ativa');
                    document.getElementById('header-title').textContent = 'Visualização do Carregamento';
                    renderizarVisualizacao();
                }

                if (fecharMenu) {
                    document.getElementById('sidebar').classList.add('collapsed');
                }
            }

            function renderizarFilaProgramacao() {
                var tbody = document.getElementById('tbody-fila-programacao');
                var portaoSel = Number(document.getElementById('prog-portao').value) || 1;
                var portaoStr = portaoSel < 10 ? '0' + portaoSel : '' + portaoSel;
                var ocAtual = (document.getElementById('prog-oc').value || '').trim() || '-';

                if (filaProgramacao.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="9" style="padding:14px; color:#64748b;">' +
                        'Nenhum item adicionado na lista para o Portão ' + portaoStr + ' (OC: ' + ocAtual + '). Você pode incluir itens ou enviar direto.' +
                        '</td></tr>';
                    return;
                }

                var html = '';
                for (var i = 0; i < filaProgramacao.length; i++) {
                    var it = filaProgramacao[i];
                    var pStr = it.portao < 10 ? '0' + it.portao : '' + it.portao;
                    html += '<tr>' +
                        '<td>Portão ' + pStr + '</td>' +
                        '<td style="font-weight:700; color:#1d4ed8;">' + it.oc + '</td>' +
                        '<td style="font-family:monospace; font-weight:700;">' + it.px + '</td>' +
                        '<td>' + it.lado + '</td>' +
                        '<td style="font-family:monospace; font-weight:700;">' + it.pallet + '</td>' +
                        '<td style="font-family:monospace;">' + it.lote + '</td>' +
                        '<td style="font-family:monospace;">' + it.box + '</td>' +
                        '<td style="font-weight:700;">' + it.caixas + '</td>' +
                        '<td><button type="button" data-remover="' + i + '" style="background:#dc2626; color:#fff; border:none; padding:2px 7px; border-radius:2px; cursor:pointer; font-size:10px;">Remover</button></td>' +
                    '</tr>';
                }
                tbody.innerHTML = html;

                var btnsRem = tbody.querySelectorAll('button[data-remover]');
                for (var r = 0; r < btnsRem.length; r++) {
                    btnsRem[r].addEventListener('click', function() {
                        var idx = Number(this.getAttribute('data-remover'));
                        filaProgramacao.splice(idx, 1);
                        renderizarFilaProgramacao();
                    });
                }
            }

            function incluirItemNaLista() {
                var oc = (document.getElementById('prog-oc').value || '').trim();
                var portao = Number(document.getElementById('prog-portao').value) || 1;
                var lado = document.getElementById('prog-lado').value;
                var pxRaw = (document.getElementById('prog-px').value || '').trim();
                var pallet = (document.getElementById('prog-pallet').value || '').trim();
                var lote = (document.getElementById('prog-lote').value || '').trim();
                var box = (document.getElementById('prog-box').value || '').trim();
                var caixas = Number(document.getElementById('prog-caixas').value) || 0;

                if (!oc) {
                    alert('Informe a Ordem de Carregamento (OC).');
                    return;
                }
                if (!pallet) {
                    alert('Informe o número do Pallet.');
                    return;
                }

                var pxPad = pxRaw ? (pxRaw.length === 1 ? '0' + pxRaw : pxRaw) : '01';

                filaProgramacao.push({
                    portao: portao,
                    oc: oc,
                    lado: lado,
                    px: pxPad,
                    pallet: pallet,
                    lote: lote || '-',
                    box: box || '-',
                    caixas: caixas
                });

                document.getElementById('prog-pallet').value = '';
                document.getElementById('prog-caixas').value = '';
                renderizarFilaProgramacao();
            }

            function enviarParaCarregamento() {
                var oc = (document.getElementById('prog-oc').value || '').trim();
                var portao = Number(document.getElementById('prog-portao').value) || 1;
                var setor = document.getElementById('prog-setor').value;

                if (!oc && filaProgramacao.length === 0) {
                    alert('Informe a Ordem de Carregamento (OC) ou adicione um item na programação.');
                    return;
                }

                var portaoAlvo = portao;
                var ocFinal = oc;

                if (filaProgramacao.length > 0) {
                    for (var i = 0; i < filaProgramacao.length; i++) {
                        var item = filaProgramacao[i];
                        var pNum = item.portao;
                        if (!estadoSistema.portoes[pNum]) {
                            estadoSistema.portoes[pNum] = { oc: item.oc, itens: [] };
                        }
                        estadoSistema.portoes[pNum].oc = item.oc;
                        estadoSistema.portoes[pNum].itens.push({
                            px: item.px,
                            lado: item.lado,
                            pallet: item.pallet,
                            lote: item.lote,
                            box: item.box,
                            caixas: item.caixas,
                            atividade: 'Programado',
                            operador: ''
                        });
                        portaoAlvo = pNum;
                        ocFinal = item.oc;
                    }
                    filaProgramacao = [];
                    renderizarFilaProgramacao();
                } else {
                    if (!estadoSistema.portoes[portaoAlvo]) {
                        estadoSistema.portoes[portaoAlvo] = { oc: ocFinal, itens: [] };
                    }
                    estadoSistema.portoes[portaoAlvo].oc = ocFinal;
                }

                estadoSistema.portaoAtivo = portaoAlvo;
                gravarStorage(STORAGE_KEY, estadoSistema);

                document.getElementById('select-setor').value = setor;
                var pStr = portaoAlvo < 10 ? '0' + portaoAlvo : '' + portaoAlvo;
                mostrarAviso('OC ' + ocFinal + ' enviada para o Portão ' + pStr);
                abrirAba('visualizacao', false);
            }

            function renderizarVisualizacao() {
                var ativo = Number(estadoSistema.portaoAtivo) || 1;
                var bloqueados = [1, 9, 21, 22, 23, 24, 25, 27, 28, 29, 30];

                var stripHtml = '';
                for (var i = 1; i <= 30; i++) {
                    var numStr = i < 10 ? '0' + i : '' + i;
                    var temOrdem = estadoSistema.portoes[i] && estadoSistema.portoes[i].oc;
                    var cls = 'portao-btn portao-livre';
                    if (bloqueados.indexOf(i) > -1 && !temOrdem) cls = 'portao-btn portao-bloqueado';
                    if (temOrdem) cls = 'portao-btn portao-programado';
                    if (ativo === i) cls += ' selecionado';

                    stripHtml += '<button type="button" data-portao="' + i + '" class="' + cls + '">' + numStr + '</button>';
                }

                var grid = document.getElementById('grid-portoes');
                grid.innerHTML = stripHtml;

                var btns = grid.querySelectorAll('button[data-portao]');
                for (var b = 0; b < btns.length; b++) {
                    btns[b].addEventListener('click', function() {
                        estadoSistema.portaoAtivo = Number(this.getAttribute('data-portao'));
                        gravarStorage(STORAGE_KEY, estadoSistema);
                        renderizarVisualizacao();
                    });
                }

                var dadosPortao = estadoSistema.portoes[ativo] || { oc: '', itens: [] };
                var atStr = ativo < 10 ? '0' + ativo : '' + ativo;

                document.getElementById('titulo-portao-ativo').textContent =
                    'Portão ' + atStr + ' - Ordem de carregamento: ' + (dadosPortao.oc || '-');

                var totalCaixas = 0;
                var ocupL1 = {};
                var ocupL2 = {};

                for (var k = 0; k < dadosPortao.itens.length; k++) {
                    var reg = dadosPortao.itens[k];
                    totalCaixas += Number(reg.caixas) || 0;
                    var nPx = Number(reg.px);
                    if (reg.lado === 'L1') ocupL1[nPx] = true;
                    if (reg.lado === 'L2') ocupL2[nPx] = true;
                }

                document.getElementById('resumo-portao-ativo').textContent =
                    'Pallets: ' + dadosPortao.itens.length + ' | Total Caixas: ' + totalCaixas;

                var l1Html = '';
                var l2Html = '';
                for (var p = 1; p <= 11; p++) {
                    l1Html += '<div class="pos-btn ' + (ocupL1[p] ? 'pos-ocupada' : 'pos-livre') + '">' + p + '</div>';
                    l2Html += '<div class="pos-btn ' + (ocupL2[p] ? 'pos-ocupada' : 'pos-livre') + '">' + p + '</div>';
                }
                document.getElementById('mapa-lado1').innerHTML = l1Html;
                document.getElementById('mapa-lado2').innerHTML = l2Html;

                var tbody = document.getElementById('tbody-portao-pallets');
                if (dadosPortao.itens.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" style="padding:16px; color:#64748b;">' +
                        (dadosPortao.oc
                            ? 'Ordem ' + dadosPortao.oc + ' programada no Portão ' + atStr + ' (sem pallets adicionados na grade).'
                            : 'Nenhuma ordem programada no Portão ' + atStr + '.') +
                        '</td></tr>';
                    return;
                }

                var rowsHtml = '';
                for (var r = 0; r < dadosPortao.itens.length; r++) {
                    var item = dadosPortao.itens[r];
                    var badge = item.lado === 'L2'
                        ? '<span style="background:#38a86b; color:#fff; padding:1px 6px; border-radius:9px; font-size:10px; font-weight:700; margin-left:4px;">L2</span>'
                        : '<span style="background:#2d74b8; color:#fff; padding:1px 6px; border-radius:9px; font-size:10px; font-weight:700; margin-left:4px;">L1</span>';

                    rowsHtml += '<tr>' +
                        '<td style="font-family:monospace; font-weight:700;">' + item.px + badge + '</td>' +
                        '<td style="background:#ef4444; color:#fff; font-family:monospace; font-weight:700;">' + item.pallet + '</td>' +
                        '<td style="font-family:monospace;">' + item.lote + '</td>' +
                        '<td style="font-family:monospace;">' + item.box + '</td>' +
                        '<td>Portão ' + atStr + '</td>' +
                        '<td style="font-family:monospace; font-weight:700;">' + item.caixas + '</td>' +
                        '<td>' + (item.atividade || '') + '</td>' +
                        '<td>' + (item.operador || '') + '</td>' +
                    '</tr>';
                }
                tbody.innerHTML = rowsHtml;
            }

            // Listeners
            document.getElementById('btn-toggle-sidebar').addEventListener('click', function() {
                document.getElementById('sidebar').classList.toggle('collapsed');
            });

            document.getElementById('menu-search').addEventListener('keyup', function() {
                var termo = this.value.toLowerCase();
                var lis = document.querySelectorAll('#sidebar-menu-list li');
                for (var i = 0; i < lis.length; i++) {
                    lis[i].style.display = lis[i].textContent.toLowerCase().indexOf(termo) > -1 ? 'block' : 'none';
                }
            });

            var abasBtns = document.querySelectorAll('[data-aba]');
            for (var a = 0; a < abasBtns.length; a++) {
                abasBtns[a].addEventListener('click', function() {
                    var destino = this.getAttribute('data-aba');
                    var fechar = this.tagName === 'LI';
                    abrirAba(destino, fechar);
                });
            }

            document.getElementById('prog-portao').addEventListener('change', renderizarFilaProgramacao);
            document.getElementById('prog-oc').addEventListener('input', renderizarFilaProgramacao);
            document.getElementById('btn-add-item-prog').addEventListener('click', incluirItemNaLista);
            document.getElementById('btn-enviar-carregamento').addEventListener('click', enviarParaCarregamento);

            document.getElementById('btn-limpar-prog').addEventListener('click', function() {
                filaProgramacao = [];
                document.getElementById('prog-oc').value = '';
                document.getElementById('prog-obs').value = '';
                document.getElementById('prog-px').value = '';
                document.getElementById('prog-pallet').value = '';
                document.getElementById('prog-lote').value = '';
                document.getElementById('prog-box').value = '';
                document.getElementById('prog-caixas').value = '';
                renderizarFilaProgramacao();
            });

            document.getElementById('btn-voltar-programacao').addEventListener('click', function() {
                document.getElementById('prog-portao').value = String(estadoSistema.portaoAtivo || 1);
                abrirAba('programacao', false);
                renderizarFilaProgramacao();
            });

            document.getElementById('btn-limpar-portao-atual').addEventListener('click', function() {
                var pNum = Number(estadoSistema.portaoAtivo) || 1;
                delete estadoSistema.portoes[pNum];
                gravarStorage(STORAGE_KEY, estadoSistema);
                renderizarVisualizacao();
            });

            document.getElementById('btn-refresh-cd').addEventListener('click', renderizarVisualizacao);
            document.getElementById('select-setor').addEventListener('change', renderizarVisualizacao);

            popularSelectPortoes();
            renderizarFilaProgramacao();
        })();
    </script>
</body>
</html>
