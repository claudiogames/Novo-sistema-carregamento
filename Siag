<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIAG - Simulação Real de Carregamento (12 Portões / 500k Pares)</title>
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #d6dce7;
            color: #1e293b;
            margin: 0;
            overflow-x: hidden;
        }
        .siag-header {
            background-color: #2f3b52;
            color: #ffffff;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 12px;
        }
        .siag-subbar {
            background-color: #263146;
            color: #cbd5e1;
            font-size: 11px;
            padding: 6px 12px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            border-bottom: 1px solid #1e2738;
        }
        .tabs-barra {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 5px;
        }
        .tab-btn {
            background-color: #344463;
            color: #e2e8f0;
            border: 1px solid #485d85;
            border-radius: 2px;
            padding: 5px 12px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }
        .tab-btn:hover {
            background-color: #41557a;
            color: #ffffff;
        }
        .tab-btn.ativa {
            background-color: #38a86b;
            border-color: #2e8f59;
            color: #ffffff;
        }
        .siag-sidebar {
            background-color: #2c66a8;
            color: #ffffff;
            width: 250px;
            flex-shrink: 0;
            transition: width 0.2s ease;
        }
        .siag-sidebar.collapsed {
            width: 0;
            overflow: hidden;
        }
        .siag-sidebar-header {
            background-color: #22538c;
            padding: 12px;
            text-align: center;
            font-size: 11px;
            font-weight: 700;
            line-height: 1.3;
        }
        .siag-menu-item {
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 11px;
            font-weight: 600;
            padding: 8px 12px;
            cursor: pointer;
        }
        .siag-menu-item:hover {
            background-color: #1e4b7e;
        }
        /* PAINEL DE METAS E INDICADORES */
        .kpi-strip {
            background-color: #e8ecf4;
            border: 1px solid #b5c0d1;
            padding: 8px 10px;
            margin-bottom: 8px;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(140px, 1fr));
            gap: 8px;
        }
        @media (max-width: 1020px) {
            .kpi-grid {
                grid-template-columns: repeat(2, minmax(140px, 1fr));
            }
        }
        .kpi-card {
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            border-left: 4px solid #2d74b8;
            padding: 6px 8px;
            border-radius: 2px;
        }
        .kpi-card.meta-ok {
            border-left-color: #38a86b;
        }
        .kpi-card.alerta {
            border-left-color: #dc2626;
        }
        .kpi-titulo {
            font-size: 10px;
            font-weight: 700;
            color: #475569;
            text-transform: uppercase;
        }
        .kpi-valor {
            font-size: 14px;
            font-weight: 800;
            color: #0f172a;
            margin-top: 2px;
            font-family: monospace;
        }
        .kpi-sub {
            font-size: 10px;
            color: #64748b;
            margin-top: 1px;
        }
        .barra-progresso {
            width: 100%;
            height: 6px;
            background-color: #e2e8f0;
            border-radius: 2px;
            overflow: hidden;
            margin-top: 4px;
        }
        .barra-progresso-fill {
            height: 100%;
            background-color: #2d74b8;
            transition: width 0.25s linear;
        }
        .painel-box {
            background-color: #e8ecf4;
            border: 1px solid #b5c0d1;
            margin-bottom: 10px;
        }
        .siag-panel-bar {
            background-color: #344463;
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
            padding: 6px 10px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }
        .siag-input {
            background-color: #ffffff;
            border: 1px solid #b5c0d1;
            border-radius: 2px;
            padding: 5px 8px;
            font-size: 12px;
            color: #1e293b;
            outline: none;
        }
        .siag-input:focus {
            border-color: #2d74b8;
        }
        .btn-azul {
            background-color: #2d74b8;
            color: #ffffff;
            border: 1px solid #225a91;
            border-radius: 2px;
            padding: 5px 11px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-azul:hover {
            background-color: #225a91;
        }
        .btn-verde {
            background-color: #38a86b;
            color: #ffffff;
            border: 1px solid #2b8754;
            border-radius: 2px;
            padding: 6px 12px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
        }
        .btn-verde:hover {
            background-color: #2e8f59;
        }
        .btn-neutro {
            background-color: #cbd5e1;
            color: #1e293b;
            border: 1px solid #94a3b8;
            border-radius: 2px;
            padding: 5px 10px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-neutro:hover {
            background-color: #b8c4d4;
        }
        .siag-table {
            width: 100%;
            border-collapse: collapse;
            background-color: #ffffff;
        }
        .siag-table th {
            background-color: #2d74b8;
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            padding: 6px 6px;
            border-right: 1px solid #5995ce;
            text-align: center;
        }
        .siag-table td {
            font-size: 11px;
            padding: 5px 6px;
            border-bottom: 1px solid #cbd5e1;
            text-align: center;
            vertical-align: middle;
        }
        .linha-selecionada {
            background-color: #dbeafe !important;
        }
        .linha-alocada {
            background-color: #f0fdf4;
        }
        .badge {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 2px;
            font-weight: 700;
            font-size: 10px;
        }
        .badge-preparo {
            background-color: #fef3c7;
            color: #92400e;
            border: 1px solid #f59e0b;
        }
        .badge-carregando {
            background-color: #dbeafe;
            color: #1e40af;
            border: 1px solid #3b82f6;
        }
        .badge-fechada {
            background-color: #dcfce7;
            color: #166534;
            border: 1px solid #22c55e;
        }
        .badge-aguardando {
            background-color: #f1f5f9;
            color: #475569;
            border: 1px solid #cbd5e1;
        }
        .mini-prog-wrap {
            width: 92px;
            height: 8px;
            background-color: #e2e8f0;
            border-radius: 2px;
            overflow: hidden;
            display: inline-block;
            vertical-align: middle;
            margin-right: 4px;
        }
        .mini-prog-bar {
            height: 100%;
            background-color: #2d74b8;
            transition: width 0.25s linear;
        }
        .mini-prog-bar.fechada {
            background-color: #38a86b;
        }
        .mini-prog-bar.preparo {
            background-color: #f59e0b;
        }
        /* FAIXA DE 12 PORTÕES */
        .portoes-wrapper {
            background: #e8ecf4;
            border: 1px solid #cbd5e1;
            padding: 6px;
            margin-bottom: 8px;
            overflow-x: auto;
        }
        .portoes-strip-12 {
            display: grid;
            grid-template-columns: repeat(12, minmax(76px, 1fr));
            width: 100%;
            min-width: 912px;
            border: 1px solid #9aa4b2;
        }
        .portao-12-btn {
            min-height: 52px;
            border: none;
            border-right: 1px solid #9aa4b2;
            font-size: 11px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 3px 2px;
            line-height: 1.2;
        }
        .portao-12-btn:last-child {
            border-right: none;
        }
        .portao-livre {
            background-color: #e5e7eb;
            color: #334155;
        }
        .portao-preparo {
            background-color: #fbbf24;
            color: #1e293b;
            font-weight: 700;
        }
        .portao-carregando {
            background-color: #2d74b8;
            color: #ffffff;
            font-weight: 700;
        }
        .portao-fechado {
            background-color: #38a86b;
            color: #ffffff;
            font-weight: 700;
        }
        .portao-12-btn.selecionado {
            box-shadow: inset 0 0 0 2px #0f172a;
        }
        /* COLUNAS 1 E 2 (11 POSIÇÕES CADA = 22 PALLETS) */
        .pos-btn {
            display: block;
            width: 46px;
            padding: 4px 0;
            margin-bottom: 3px;
            font-size: 10px;
            font-weight: 700;
            text-align: center;
            cursor: pointer;
        }
        .pos-ocupada {
            background-color: #ef4444;
            color: #ffffff;
            border: 1px solid #b91c1c;
        }
        .pos-livre {
            background-color: #e2e8f0;
            color: #475569;
            border: 1px solid #94a3b8;
        }
        .pos-selecionada {
            outline: 2px solid #1d4ed8;
        }
    </style>
</head>
<body>

    <!-- CABEÇALHO SUPERIOR -->
    <header class="siag-header">
        <div style="display:flex; align-items:center; gap:12px;">
            <button type="button" id="btn-toggle-sidebar" style="background:none; border:none; color:white; font-size:18px; cursor:pointer;" title="Menu">☰</button>
            <span id="header-title" style="font-size:14px; font-weight:600; letter-spacing:0.3px;">
                Programação &amp; Sequenciamento — 1 min Preparo + Ciclo Real
            </span>
        </div>

        <div style="font-size:12px; color:#e2e8f0;">
            Simulação Real PCP / Expedição • 8h Turno
        </div>
    </header>

    <!-- BARRA DE GUIAS -->
    <nav class="siag-subbar">
        <div class="tabs-barra">
            <button type="button" id="tab-programacao" data-aba="programacao" class="tab-btn ativa">Programação (22 Ordens)</button>
            <button type="button" id="tab-visualizacao" data-aba="visualizacao" class="tab-btn">Visualização do Carregamento (12 Portões)</button>
        </div>
        <div id="status-aviso" style="font-size:11px; color:#86efac; font-weight:600;"></div>
    </nav>

    <!-- JANELA FIXA DE METAS E INDICADORES -->
    <div class="kpi-strip">
        <div class="kpi-grid">
            <div id="kpi-card-pares" class="kpi-card">
                <div class="kpi-titulo">Pares Carregados / Meta</div>
                <div id="kpi-pares" class="kpi-valor">0 / 500.000</div>
                <div id="kpi-pares-sub" class="kpi-sub">Carregando + Fechados • 25 pares/cx</div>
                <div class="barra-progresso">
                    <div id="barra-pares" class="barra-progresso-fill" style="width:0%;"></div>
                </div>
            </div>

            <div id="kpi-card-ordens" class="kpi-card">
                <div class="kpi-titulo">Ordens (Fechadas / Total)</div>
                <div id="kpi-ordens" class="kpi-valor">0 / 22</div>
                <div id="kpi-caixas-sub" class="kpi-sub">0 / 20.000 caixas carregadas</div>
                <div class="barra-progresso">
                    <div id="barra-ordens" class="barra-progresso-fill" style="width:0%; background:#38a86b;"></div>
                </div>
            </div>

            <div id="kpi-card-tempo" class="kpi-card">
                <div class="kpi-titulo">Carga de Turno (8h)</div>
                <div id="kpi-tempo" class="kpi-valor">0,0h / 8,0h</div>
                <div id="kpi-tempo-sub" class="kpi-sub">480 min disponíveis no dia</div>
                <div class="barra-progresso">
                    <div id="barra-tempo" class="barra-progresso-fill" style="width:0%; background:#d97706;"></div>
                </div>
            </div>

            <div id="kpi-card-portoes" class="kpi-card">
                <div class="kpi-titulo">Portões Ativos (12)</div>
                <div id="kpi-portoes" class="kpi-valor">0 / 12</div>
                <div id="kpi-pallets-sub" class="kpi-sub">Máx. 22 pallets/portão (Col 1 + Col 2)</div>
            </div>

            <div id="kpi-card-prazo" class="kpi-card">
                <div class="kpi-titulo">Prazos Hoje Atendidos</div>
                <div id="kpi-prazo" class="kpi-valor">0 / 10</div>
                <div id="kpi-prazo-sub" class="kpi-sub">Ordens de Hoje programadas/fechadas</div>
            </div>
        </div>
    </div>

    <!-- CORPO PRINCIPAL -->
    <div style="display:flex; min-height:calc(100vh - 155px);">

        <!-- BARRA LATERAL -->
        <aside id="sidebar" class="siag-sidebar collapsed">
            <div class="siag-sidebar-header">
                SISTEMA INTEGRADO DE<br>ARMAZENAGEM GRENDENE
            </div>
            <ul id="sidebar-menu-list" style="list-style:none; margin:0; padding:0;">
                <li data-aba="programacao" class="siag-menu-item">+ PROGRAMAÇÃO (22 ORDENS)</li>
                <li data-aba="visualizacao" class="siag-menu-item">+ VISUALIZAÇÃO DO CARREGAMENTO</li>
            </ul>
            <div style="padding:10px; font-size:11px; line-height:1.45; color:#dbeafe; border-top:1px solid rgba(255,255,255,0.15);">
                <strong>Dinâmica Real de Operação:</strong><br>
                1. Ao alocar no portão, a ordem aguarda <strong>1 minuto real (01:00)</strong> de preparo.<br>
                2. Após 1 min, entra em <strong>Carregando</strong> e avança o progresso em tempo real.<br>
                3. Ao concluir seu tempo de ciclo, a ordem passa para <strong>Fechada</strong>.
            </div>
        </aside>

        <!-- ÁREA PRINCIPAL -->
        <main style="flex:1; padding:0 8px 12px 8px; overflow-x:hidden;">

            <!-- =================================================================== -->
            <!-- ABA 1: PROGRAMAÇÃO — 22 ORDENS PRONTAS                              -->
            <!-- =================================================================== -->
            <section id="aba-programacao">
                <div class="painel-box">
                    <div class="siag-panel-bar">
                        <span>Carteira de Ordens Prontas (22 Ordens = 500.000 Pares • 20.000 Caixas)</span>
                        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:6px;">
                            <select id="filtro-prazo" class="siag-input" style="padding:4px 6px; font-size:11px;">
                                <option value="TODOS">Todos os prazos</option>
                                <option value="Hoje - Manhã">Hoje - Manhã</option>
                                <option value="Hoje - Tarde">Hoje - Tarde</option>
                                <option value="Amanhã">Amanhã</option>
                            </select>

                            <select id="select-portao-destino" class="siag-input" style="padding:4px 6px; font-size:11px; font-weight:700;"></select>

                            <button type="button" id="btn-alocar-selecionada" class="btn-verde">
                                Alocar Ordem (1m Preparo)
                            </button>

                            <button type="button" id="btn-ir-visualizacao" class="btn-azul">
                                Ver Carregamento ▶
                            </button>

                            <button type="button" id="btn-reset-simulacao" class="btn-neutro">
                                Reiniciar Simulação
                            </button>
                        </div>
                    </div>

                    <div id="info-ordem-selecionada" style="padding:8px 10px; background:#f8fafc; border-bottom:1px solid #cbd5e1; font-size:11px; color:#334155;">
                        Selecione uma ordem e escolha o portão de destino (01 a 12). Cada ordem aguarda 1 min real (01:00) de preparo antes de iniciar o carregamento.
                    </div>

                    <div style="overflow-x:auto; background:#ffffff;">
                        <table class="siag-table">
                            <thead>
                                <tr>
                                    <th>OC</th>
                                    <th>Cliente / Rota</th>
                                    <th>Prazo</th>
                                    <th>Pares</th>
                                    <th>Caixas</th>
                                    <th>Pallets</th>
                                    <th>Ciclo / Turno</th>
                                    <th>Status</th>
                                    <th>Fechamento</th>
                                    <th>Progresso Real</th>
                                    <th>Ação</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-ordens-programacao"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- =================================================================== -->
            <!-- ABA 2: VISUALIZAÇÃO DO CARREGAMENTO — 12 PORTÕES                    -->
            <!-- =================================================================== -->
            <section id="aba-visualizacao" style="display:none;">
                <div class="painel-box" style="padding:8px 10px; margin-bottom:8px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px;">
                    <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; font-size:11px;">
                        <strong>Setor:</strong>
                        <span style="background:#ffffff; border:1px solid #cbd5e1; padding:3px 8px; border-radius:2px;">4 - Expedição (12 Portões)</span>
                        <span style="color:#475569;">Amarelo: Preparo (1m) • Azul: Carregando • Verde: Fechado • Cinza: Livre</span>
                    </div>

                    <div style="display:flex; flex-wrap:wrap; gap:6px;">
                        <button type="button" id="btn-voltar-programacao" class="btn-azul">+ Alocar Mais Ordens</button>
                        <button type="button" id="btn-desalocar-portao" class="btn-neutro">Liberar Portão Atual</button>
                    </div>
                </div>

                <!-- FAIXA DE 12 PORTÕES -->
                <div class="portoes-wrapper">
                    <div id="grid-portoes-12" class="portoes-strip-12"></div>
                </div>

                <!-- DETALHE DO PORTÃO SELECIONADO (COLUNA 1 + COLUNA 2 = 22 PALLETS + TABELA) -->
                <div class="painel-box" style="padding:10px; display:flex; flex-wrap:wrap; gap:16px;">
                    <div style="display:flex; gap:12px; padding-top:4px;">
                        <div>
                            <div style="background:#2d74b8; color:#ffffff; font-size:10px; font-weight:700; padding:4px 8px; text-align:center; margin-bottom:4px;">
                                Coluna 1 (1-11)
                            </div>
                            <div id="mapa-col1"></div>
                        </div>
                        <div>
                            <div style="background:#38a86b; color:#ffffff; font-size:10px; font-weight:700; padding:4px 8px; text-align:center; margin-bottom:4px;">
                                Coluna 2 (1-11)
                            </div>
                            <div id="mapa-col2"></div>
                        </div>
                    </div>

                    <div style="flex:1; min-width:300px;">
                        <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px; margin-bottom:8px;">
                            <div id="titulo-portao-detalhe" style="font-size:12px; font-weight:700; color:#1e293b;">
                                Portão 01 — Livre
                            </div>
                            <div id="metricas-portao-detalhe" style="font-size:11px; font-weight:600; color:#334155;">
                                Pallets: 0 / 22 • Pares: 0 • Tempo Turno: 0 min
                            </div>
                        </div>

                        <div style="overflow-x:auto; border:1px solid #cbd5e1; background:#ffffff;">
                            <table class="siag-table">
                                <thead>
                                    <tr>
                                        <th>Pos</th>
                                        <th>Coluna</th>
                                        <th>OC</th>
                                        <th>Pallet</th>
                                        <th>Pares</th>
                                        <th>Caixas</th>
                                        <th>Status</th>
                                        <th>Progresso</th>
                                        <th>Ação</th>
                                    </tr>
                                </thead>
                                <tbody id="tbody-portao-detalhe"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

        </main>
    </div>

    <script>
        (function() {
            var ORDENS_BASE = [
                { id: 'OC-101', cliente: 'Magazine Sul - CE', prazo: 'Hoje - Manhã', caixas: 1400, pallets: 7, minutosTurno: 32, duracaoRealSeg: 600 },
