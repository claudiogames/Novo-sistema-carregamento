            var PARES_POR_CAIXA = 25;
            var META_PARES = 500000;
            var META_ORDENS = 22;
            var MINUTOS_DISPONIVEIS = 480;
            var MAX_PALLETS_PORTAO = 22;
            var PREPARO_SEGUNDOS = 60; // 1 minuto real de preparo

            var ordemSelecionadaId = 'OC-101';
            var portaoDestinoSelecionado = 1;
            var portaoAtivo = 1;
            var filtroSlotAtivo = null;

            var ordensEmExecucao = {};
            var estadoPortoes = {};

            function inicializarEstado() {
                ordensEmExecucao = {};
                estadoPortoes = {};
                for (var p = 1; p <= 12; p++) {
                    estadoPortoes[p] = { slots: [] };
                }
            }

            function formatarNumero(n) {
                return Number(n || 0).toLocaleString('pt-BR');
            }

            function formatarTempoTurno(min) {
                var h = Math.floor(min / 60);
                var m = min % 60;
                if (h === 0) return m + ' min';
                return h + 'h ' + (m < 10 ? '0' + m : m) + 'min';
            }

            function formatarMMSS(seg) {
                var s = Math.max(0, Math.floor(seg));
                var min = Math.floor(s / 60);
                var rem = s % 60;
                return String(min).padStart(2, '0') + ':' + String(rem).padStart(2, '0');
            }

            function mostrarAviso(texto) {
                var el = document.getElementById('status-aviso');
                el.textContent = texto;
                setTimeout(function() {
                    if (el.textContent === texto) el.textContent = '';
                }, 4000);
            }

            // Só atualiza os textos das opções sem destruir a escolha do usuário
            function sincronizarOpcoesPortoes12() {
                var sel = document.getElementById('select-portao-destino');
                if (sel.options.length !== 12) {
                    var html = '';
                    for (var p = 1; p <= 12; p++) {
                        var pStr = p < 10 ? '0' + p : '' + p;
                        var qtdPal = estadoPortoes[p].slots.length;
                        html += '<option value="' + p + '">Portão ' + pStr + ' (' + qtdPal + '/22 pallets)</option>';
                    }
                    sel.innerHTML = html;
                } else {
                    for (var idx = 0; idx < 12; idx++) {
                        var numP = idx + 1;
                        var pLabel = numP < 10 ? '0' + numP : '' + numP;
                        var qtd = estadoPortoes[numP].slots.length;
                        sel.options[idx].text = 'Portão ' + pLabel + ' (' + qtd + '/22 pallets)';
                    }
                }
                sel.value = String(portaoDestinoSelecionado);
            }

            function encontrarOrdem(id) {
                for (var i = 0; i < ORDENS_BASE.length; i++) {
                    if (ORDENS_BASE[i].id === id) return ORDENS_BASE[i];
                }
                return null;
            }

            function gerarSlotsLivres(portaoNum, quantidadeNecessaria) {
                var ocupados = {};
                var slotsAtuais = estadoPortoes[portaoNum].slots;
                for (var i = 0; i < slotsAtuais.length; i++) {
                    ocupados[slotsAtuais[i].coluna + '-' + slotsAtuais[i].pos] = true;
                }

                var livres = [];
                var cols = ['Col 1', 'Col 2'];
                for (var c = 0; c < cols.length; c++) {
                    for (var pos = 1; pos <= 11; pos++) {
                        var chave = cols[c] + '-' + pos;
                        if (!ocupados[chave]) {
                            livres.push({ coluna: cols[c], pos: pos });
                            if (livres.length === quantidadeNecessaria) {
                                return livres;
                            }
                        }
                    }
                }
                return null;
            }

            function alocarOrdemNoPortao(ordemId, portaoNum) {
                var ordem = encontrarOrdem(ordemId);
                if (!ordem) return;

                if (ordensEmExecucao[ordemId]) {
                    var pAtual = ordensEmExecucao[ordemId].portao;
                    alert('A ordem ' + ordem.id + ' já está alocada no Portão ' + String(pAtual).padStart(2, '0') + '.');
                    return;
                }

                var livres = gerarSlotsLivres(portaoNum, ordem.pallets);
                if (!livres) {
                    alert('Portão ' + String(portaoNum).padStart(2, '0') + ' não possui ' + ordem.pallets + ' posições livres (máx. 22 pallets).');
                    return;
                }

                var caixasPorPallet = Math.floor(ordem.caixas / ordem.pallets);
                var restoCaixas = ordem.caixas % ordem.pallets;

                for (var i = 0; i < ordem.pallets; i++) {
                    var cxsPallet = caixasPorPallet + (i === 0 ? restoCaixas : 0);
                    var paresPallet = cxsPallet * PARES_POR_CAIXA;
                    estadoPortoes[portaoNum].slots.push({
                        pos: livres[i].pos,
                        coluna: livres[i].coluna,
                        ordemId: ordem.id,
                        cliente: ordem.cliente,
                        prazo: ordem.prazo,
                        palletCod: ordem.id.replace('OC-', 'PLT-') + '-' + String(i + 1).padStart(2, '0'),
                        caixas: cxsPallet,
                        pares: paresPallet,
                        minutosTurno: i === 0 ? ordem.minutosTurno : 0
                    });
                }

                ordensEmExecucao[ordem.id] = {
                    portao: portaoNum,
                    fase: 'PREPARO',
                    preparoRestanteSeg: PREPARO_SEGUNDOS,
                    carregamentoDecorridoSeg: 0,
                    duracaoRealSeg: ordem.duracaoRealSeg,
                    progresso: 0
                };

                portaoAtivo = portaoNum;
                portaoDestinoSelecionado = portaoNum;
                mostrarAviso(ordem.id + ' alocada no Portão ' + String(portaoNum).padStart(2, '0') + ' • 01:00 de preparo');
                atualizarTela();
            }

            function iniciarCarregamentoImediato(ordemId) {
                var st = ordensEmExecucao[ordemId];
                if (!st || st.fase !== 'PREPARO') return;
                st.fase = 'CARREGANDO';
                st.preparoRestanteSeg = 0;
                mostrarAviso('Preparo concluído para ' + ordemId + ' • Carregamento iniciado');
                atualizarTela();
            }

            function removerOrdemDoSistema(ordemId) {
                delete ordensEmExecucao[ordemId];
                for (var p = 1; p <= 12; p++) {
                    estadoPortoes[p].slots = estadoPortoes[p].slots.filter(function(sl) {
                        return sl.ordemId !== ordemId;
                    });
                }
                mostrarAviso('Ordem ' + ordemId + ' removida do carregamento');
                atualizarTela();
            }

            function liberarPortao(portaoNum) {
                var slots = estadoPortoes[portaoNum].slots;
                for (var i = 0; i < slots.length; i++) {
                    delete ordensEmExecucao[slots[i].ordemId];
                }
                estadoPortoes[portaoNum].slots = [];
                filtroSlotAtivo = null;
                mostrarAviso('Portão ' + String(portaoNum).padStart(2, '0') + ' liberado');
                atualizarTela();
            }

            function tickSegundos() {
                var houveMudanca = false;
                var ids = Object.keys(ordensEmExecucao);

                for (var i = 0; i < ids.length; i++) {
                    var id = ids[i];
                    var st = ordensEmExecucao[id];

                    if (st.fase === 'PREPARO') {
                        houveMudanca = true;
                        st.preparoRestanteSeg = Math.max(0, st.preparoRestanteSeg - 1);
                        if (st.preparoRestanteSeg <= 0) {
                            st.fase = 'CARREGANDO';
                            st.carregamentoDecorridoSeg = 0;
                            st.progresso = 0;
                        }
                    } else if (st.fase === 'CARREGANDO') {
                        houveMudanca = true;
                        st.carregamentoDecorridoSeg = Math.min(st.duracaoRealSeg, st.carregamentoDecorridoSeg + 1);
                        st.progresso = st.duracaoRealSeg > 0 ? (st.carregamentoDecorridoSeg / st.duracaoRealSeg) : 1;
                        if (st.carregamentoDecorridoSeg >= st.duracaoRealSeg) {
                            st.progresso = 1;
                            st.fase = 'FECHADA';
                            mostrarAviso('Ordem ' + id + ' concluída e FECHADA no Portão ' + String(st.portao).padStart(2, '0'));
                        }
                    }
                }

                if (houveMudanca) {
                    atualizarTela();
                }
            }

            function calcularIndicadores() {
                var paresEfetivos = 0;
                var caixasEfetivas = 0;
                var minutosTurnoAlocados = 0;
                var ordensAlocadasCount = 0;
                var ordensFechadasCount = 0;
                var prazosHojeContemplados = 0;

                for (var i = 0; i < ORDENS_BASE.length; i++) {
                    var o = ORDENS_BASE[i];
                    var st = ordensEmExecucao[o.id];
                    if (st) {
                        ordensAlocadasCount++;
                        minutosTurnoAlocados += o.minutosTurno;
                        if (o.prazo.indexOf('Hoje') === 0) {
                            prazosHojeContemplados++;
                        }
                        var fator = st.fase === 'FECHADA' ? 1 : (st.fase === 'CARREGANDO' ? st.progresso : 0);
                        var cxsProg = Math.round(o.caixas * fator);
                        caixasEfetivas += cxsProg;
                        paresEfetivos += cxsProg * PARES_POR_CAIXA;
                        if (st.fase === 'FECHADA') {
                            ordensFechadasCount++;
                        }
                    }
                }

                var portoesAtivos = 0;
                for (var p = 1; p <= 12; p++) {
                    if (estadoPortoes[p].slots.length > 0) portoesAtivos++;
                }

                return {
                    paresEfetivos: paresEfetivos,
                    caixasEfetivas: caixasEfetivas,
                    minutosTurnoAlocados: minutosTurnoAlocados,
                    ordensAlocadasCount: ordensAlocadasCount,
                    ordensFechadasCount: ordensFechadasCount,
                    portoesAtivos: portoesAtivos,
                    prazosHojeContemplados: prazosHojeContemplados
                };
            }

            function renderizarKPIs(ind) {
                var pctPares = Math.min(100, Math.round((ind.paresEfetivos / META_PARES) * 1000) / 10);
                var pctOrdens = Math.min(100, Math.round((ind.ordensFechadasCount / META_ORDENS) * 1000) / 10);
                var pctTempo = Math.min(100, Math.round((ind.minutosTurnoAlocados / MINUTOS_DISPONIVEIS) * 1000) / 10);
                var horasTurnoStr = (ind.minutosTurnoAlocados / 60).toFixed(1).replace('.', ',');

                document.getElementById('kpi-pares').textContent = formatarNumero(ind.paresEfetivos) + ' / 500.000';
                document.getElementById('kpi-pares-sub').textContent = pctPares + '% carregado • Meta diária 500k pares';
                document.getElementById('barra-pares').style.width = pctPares + '%';

                var cardPares = document.getElementById('kpi-card-pares');
                cardPares.className = 'kpi-card ' + (ind.paresEfetivos >= META_PARES ? 'meta-ok' : '');

                document.getElementById('kpi-ordens').textContent = ind.ordensFechadasCount + ' fechadas / ' + ind.ordensAlocadasCount + ' aloc. (22)';
                document.getElementById('kpi-caixas-sub').textContent = formatarNumero(ind.caixasEfetivas) + ' / 20.000 caixas efetivas';
                document.getElementById('barra-ordens').style.width = pctOrdens + '%';

                document.getElementById('kpi-tempo').textContent = horasTurnoStr + 'h / 8,0h';
                document.getElementById('kpi-tempo-sub').textContent = ind.minutosTurnoAlocados + ' / ' + MINUTOS_DISPONIVEIS + ' min de turno';
                document.getElementById('barra-tempo').style.width = pctTempo + '%';

                var cardTempo = document.getElementById('kpi-card-tempo');
                cardTempo.className = 'kpi-card ' + (ind.minutosTurnoAlocados > MINUTOS_DISPONIVEIS ? 'alerta' : '');

                document.getElementById('kpi-portoes').textContent = ind.portoesAtivos + ' / 12';

                var totalHoje = 0;
                for (var i = 0; i < ORDENS_BASE.length; i++) {
                    if (ORDENS_BASE[i].prazo.indexOf('Hoje') === 0) totalHoje++;
                }
                document.getElementById('kpi-prazo').textContent = ind.prazosHojeContemplados + ' / ' + totalHoje;
            }

            function renderizarTabelaProgramacao() {
                var filtroPrazo = document.getElementById('filtro-prazo').value;
                var tbody = document.getElementById('tbody-ordens-programacao');
                var html = '';

                for (var i = 0; i < ORDENS_BASE.length; i++) {
                    var o = ORDENS_BASE[i];
                    if (filtroPrazo !== 'TODOS' && o.prazo !== filtroPrazo) continue;

                    var paresTotais = o.caixas * PARES_POR_CAIXA;
                    var st = ordensEmExecucao[o.id];
                    var isSel = o.id === ordemSelecionadaId;

                    var statusBadge = '<span class="badge badge-aguardando">Aguardando</span>';
                    var fechamentoTxt = 'Ciclo ' + formatarMMSS(o.duracaoRealSeg);
                    var pctVisual = 0;
                    var barCls = 'mini-prog-bar';
                    var acaoHtml = '<button type="button" data-alocar-id="' + o.id + '" class="btn-azul" style="padding:3px 8px; font-size:10px;">Alocar</button>';

                    if (st) {
                        var pStr = String(st.portao).padStart(2, '0');
                        if (st.fase === 'PREPARO') {
                            statusBadge = '<span class="badge badge-preparo">PT ' + pStr + ' • Preparo ' + formatarMMSS(st.preparoRestanteSeg) + '</span>';
                            fechamentoTxt = 'Inicia em ' + formatarMMSS(st.preparoRestanteSeg);
                            barCls = 'mini-prog-bar preparo';
                            acaoHtml = '<button type="button" data-iniciar-id="' + o.id + '" class="btn-verde" style="padding:3px 7px; font-size:10px;">Iniciar Agora</button>';
                        } else if (st.fase === 'CARREGANDO') {
                            pctVisual = Math.round(st.progresso * 100);
                            var restSeg = Math.max(0, st.duracaoRealSeg - st.carregamentoDecorridoSeg);
                            statusBadge = '<span class="badge badge-carregando">PT ' + pStr + ' • Carregando</span>';
                            fechamentoTxt = 'Fecha em ' + formatarMMSS(restSeg);
                        } else if (st.fase === 'FECHADA') {
                            pctVisual = 100;
                            statusBadge = '<span class="badge badge-fechada">PT ' + pStr + ' • Fechada</span>';
                            fechamentoTxt = 'OC Fechada';
                            barCls = 'mini-prog-bar fechada';
                            acaoHtml = '<button type="button" data-remover-id="' + o.id + '" class="btn-neutro" style="padding:3px 7px; font-size:10px;">Limpar</button>';
