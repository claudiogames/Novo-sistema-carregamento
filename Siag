<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIAG - Consulta caixas</title>
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #d6dce7;
            color: #1e293b;
            margin: 0;
            overflow-x: hidden;
        }
        .siag-header {
            background-color: #2f3b52;
            color: #ffffff;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 12px;
        }
        .siag-subbar {
            background-color: #263146;
            color: #cbd5e1;
            font-size: 11px;
            padding: 5px 12px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 14px;
            border-bottom: 1px solid #1e2738;
        }
        .siag-subbar-item {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            color: #e2e8f0;
        }
        .siag-subbar-item:hover {
            color: #ffffff;
            text-decoration: underline;
        }
        .siag-sidebar {
            background-color: #2c66a8;
            color: #ffffff;
            width: 250px;
            flex-shrink: 0;
            transition: width 0.2s ease;
        }
        .siag-sidebar.collapsed {
            width: 0;
            overflow: hidden;
        }
        .siag-sidebar-header {
            background-color: #22538c;
            padding: 12px;
            text-align: center;
            font-size: 11px;
            font-weight: 700;
            line-height: 1.3;
        }
        .siag-menu-item {
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 11px;
            font-weight: 600;
            padding: 8px 12px;
            cursor: pointer;
        }
        .siag-menu-item:hover {
            background-color: #1e4b7e;
        }
        .btn-favorito {
            background-color: #38a86b;
            color: #ffffff;
            font-size: 12px;
            font-weight: 500;
            padding: 9px 14px;
            border-radius: 2px;
            border: none;
            cursor: pointer;
        }
        .btn-favorito:hover {
            background-color: #2f915b;
        }
        .siag-panel-bar {
            background-color: #344463;
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
            padding: 6px 10px;
        }
        .consulta-container {
            max-width: 100%;
            background-color: #d8dee9;
            padding: 8px 14px 18px 14px;
        }
        .consulta-titulo {
            text-align: center;
            font-size: 15px;
            font-weight: 700;
            color: #22304a;
            margin: 4px 0 12px 0;
        }
        .grid-4 {
            display: grid;
            grid-template-columns: repeat(4, minmax(140px, 1fr));
            gap: 10px 14px;
        }
        .grid-3 {
            display: grid;
            grid-template-columns: repeat(3, minmax(120px, 1fr));
            gap: 10px 14px;
        }
        .grid-2 {
            display: grid;
            grid-template-columns: repeat(2, minmax(140px, 1fr));
            gap: 10px 14px;
        }
        @media (max-width: 820px) {
            .grid-4 {
                grid-template-columns: repeat(2, minmax(130px, 1fr));
            }
            .grid-3 {
                grid-template-columns: 1fr;
            }
            .grid-2 {
                grid-template-columns: 1fr;
            }
        }
        .campo-label {
            display: block;
            font-size: 11px;
            color: #334155;
            margin-bottom: 3px;
            font-weight: 500;
        }
        .siag-input {
            width: 100%;
            background-color: #e6ebf2;
            border: 1px solid #b5c0d1;
            border-radius: 2px;
            padding: 5px 8px;
            font-size: 12px;
            color: #334155;
            outline: none;
        }
        .siag-input::placeholder {
            color: #8c96a6;
        }
        .siag-input:focus {
            background-color: #ffffff;
            border-color: #2d74b8;
        }
        .secao-bloco {
            margin-top: 14px;
        }
        .secao-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }
        .secao-titulo {
            font-size: 12px;
            font-weight: 700;
            color: #274a7a;
            white-space: nowrap;
        }
        .secao-linha {
            flex: 1;
            height: 1px;
            background-color: #6b84a8;
        }
        .status-grid {
            display: grid;
            grid-template-columns: repeat(6, minmax(120px, 1fr));
            gap: 8px 12px;
            margin-top: 6px;
        }
        @media (max-width: 900px) {
            .status-grid {
                grid-template-columns: repeat(3, minmax(110px, 1fr));
            }
        }
        @media (max-width: 520px) {
            .status-grid {
                grid-template-columns: repeat(2, minmax(110px, 1fr));
            }
        }
        .status-chk-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            color: #334155;
            cursor: pointer;
        }
        .rodape-acoes {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            justify-content: space-between;
            gap: 12px;
            margin-top: 14px;
            padding-top: 8px;
        }
        .btn-siag-azul {
            background-color: #3678b8;
            color: #ffffff;
            border: 1px solid #296199;
            border-radius: 2px;
            padding: 6px 14px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-siag-azul:hover {
            background-color: #296199;
        }
        .siag-table {
            width: 100%;
            border-collapse: collapse;
        }
        .siag-table th {
            background-color: #2d74b8;
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            padding: 6px 8px;
            border-right: 1px solid #5995ce;
            text-align: center;
        }
        .siag-table td {
            font-size: 11px;
            padding: 5px 8px;
            border-bottom: 1px solid #cbd5e1;
            text-align: center;
        }
        .portoes-wrapper {
            background: #e8ecf4;
            border: 1px solid #cbd5e1;
            padding: 6px;
            margin-bottom: 8px;
            overflow-x: auto;
        }
        .portoes-strip {
            display: flex;
            width: 100%;
            min-width: 900px;
            border: 1px solid #9aa4b2;
        }
        .portao-btn {
            flex: 1 0 30px;
            height: 40px;
            border: none;
            border-right: 1px solid #9aa4b2;
            font-size: 11px;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 0;
        }
        .portao-btn:last-child {
            border-right: none;
        }
        .portao-livre {
            background-color: #e5e7eb;
            color: #475569;
        }
        .portao-bloqueado {
            background-color: #9ca3af;
            color: #1e293b;
        }
        .portao-expedindo {
            background-color: #38a86b;
            color: #ffffff;
            font-weight: 700;
        }
        .portao-btn.selecionado {
            box-shadow: inset 0 0 0 2px #1d4ed8;
            font-weight: 800;
        }
        .pos-btn {
            display: block;
            width: 44px;
            padding: 4px 0;
            margin-bottom: 3px;
            font-size: 10px;
            font-weight: 700;
            text-align: center;
            cursor: pointer;
        }
        .pos-ocupada {
            background-color: #ef4444;
            color: #ffffff;
            border: 1px solid #b91c1c;
        }
        .pos-livre {
            background-color: #e2e8f0;
            color: #475569;
            border: 1px solid #94a3b8;
        }
    </style>
</head>
<body>

    <!-- CABEÇALHO SUPERIOR -->
    <header class="siag-header">
        <div style="display:flex; align-items:center; gap:12px;">
            <button type="button" id="btn-toggle-sidebar" style="background:none; border:none; color:white; font-size:18px; cursor:pointer;" title="Menu">☰</button>
            <button type="button" id="btn-inicio-top" style="background:none; border:none; color:#cbd5e1; font-size:12px; cursor:pointer;">Início</button>
        </div>

        <div id="header-title" style="font-size:14px; font-weight:600; letter-spacing:0.3px;">
            Consulta caixas
        </div>

        <div style="font-size:12px; color:#e2e8f0;">
            Benilo Araujo Carneiro ▼
        </div>
    </header>

    <!-- BARRA DE ATALHOS SECUNDÁRIA (IGUAL À CAPTURA) -->
    <div class="siag-subbar">
        <span data-nav="dashboard" class="siag-subbar-item">◔ Grendene</span>
        <span data-nav="visualizacao" class="siag-subbar-item">◔ Controle e Acompa...</span>
        <span data-nav="dashboard" class="siag-subbar-item">◔ Central | Grendene</span>
        <span id="atalho-caixas-sub" data-nav="consulta-caixas" class="siag-subbar-item" style="color:#ffffff; font-weight:700;">◔ Caixas / SIAG - Siste...</span>
    </div>

    <!-- CORPO PRINCIPAL -->
    <div style="display:flex; min-height:calc(100vh - 70px);">

        <!-- BARRA LATERAL AZUL -->
        <aside id="sidebar" class="siag-sidebar collapsed">
            <div class="siag-sidebar-header">
                SISTEMA INTEGRADO DE<br>ARMAZENAGEM GRENDENE
            </div>

            <div data-nav="dashboard" class="siag-menu-item" style="background:#255b99;">
                Página Inicial
            </div>

            <div style="padding:8px; background:#3372b8;">
                <input type="text" id="menu-search" placeholder="Pesquisar" style="width:100%; padding:4px 8px; font-size:12px; color:#1e293b; border:none; border-radius:2px;">
            </div>

            <ul id="sidebar-menu-list" style="list-style:none; margin:0; padding:0;">
                <li data-nav="visualizacao" class="siag-menu-item">+ GESTÃO VISUAL DE VEÍCULOS</li>
                <li data-nav="consulta-caixas" class="siag-menu-item">+ NOVO SIAG - CONSULTAS</li>
                <li data-nav="consulta-caixas" class="siag-menu-item">+ CAIXAS</li>
                <li data-nav="visualizacao" class="siag-menu-item">+ GESTÃO VISUAL</li>
                <li class="siag-menu-item">+ GESTÃO VISUAL - TELÕES</li>
                <li class="siag-menu-item">+ GESTÃO VISUAL - PARÂMETROS</li>
                <li class="siag-menu-item">+ TRANSPORTADORA</li>
                <li data-nav="visualizacao" class="siag-menu-item">+ MAPA DO CD</li>
                <li data-nav="visualizacao" class="siag-menu-item">+ EXPEDIÇÃO</li>
                <li data-nav="visualizacao" class="siag-menu-item">+ OPERAÇÃO DO CD</li>
                <li class="siag-menu-item">+ RELATÓRIO</li>
                <li class="siag-menu-item">+ PROGRAMAÇÃO</li>
                <li class="siag-menu-item">+ SUPERVISÓRIO - SORTER</li>
                <li class="siag-menu-item">+ SUPERVISÓRIO - MÁQUINAS</li>
            </ul>
        </aside>

        <!-- CONTEÚDO -->
        <main style="flex:1; overflow-x:hidden;">

            <!-- =================================================================== -->
            <!-- TELA CONSULTA CAIXAS (TELA PRINCIPAL QUANDO CLICA EM CAIXAS)       -->
            <!-- =================================================================== -->
            <section id="tela-consulta-caixas" class="consulta-container">
                <div class="consulta-titulo">Consulta caixas</div>

                <form id="form-consulta-caixas">
                    <!-- DATAS E HORAS -->
                    <div class="grid-4">
                        <div>
                            <label class="campo-label">Dia Inicial Embalagem</label>
                            <input type="text" id="q-dt-emb-ini" placeholder="DD/MM/YYYY" class="siag-input">
                        </div>
                        <div>
                            <label class="campo-label">Hora</label>
                            <input type="text" id="q-hr-emb-ini" value="00:00" class="siag-input">
                        </div>
                        <div>
                            <label class="campo-label">Dia Final Embalagem</label>
                            <input type="text" id="q-dt-emb-fim" placeholder="DD/MM/YYYY" class="siag-input">
                        </div>
                        <div>
                            <label class="campo-label">Hora</label>
                            <input type="text" id="q-hr-emb-fim" value="00:00" class="siag-input">
                        </div>

                        <div>
                            <label class="campo-label">Dia Inicial Sorter</label>
                            <input type="text" id="q-dt-sort-ini" placeholder="DD/MM/YYYY" class="siag-input">
                        </div>
                        <div>
                            <label class="campo-label">Hora</label>
                            <input type="text" id="q-hr-sort-ini" value="00:00" class="siag-input">
                        </div>
                        <div>
                            <label class="campo-label">Dia Final Sorter</label>
                            <input type="text" id="q-dt-sort-fim" placeholder="DD/MM/YYYY" class="siag-input">
                        </div>
                        <div>
                            <label class="campo-label">Hora</label>
                            <input type="text" id="q-hr-sort-fim" value="00:00" class="siag-input">
                        </div>

                        <div>
                            <label class="campo-label">Dia Inicial Estufamento</label>
                            <input type="text" id="q-dt-est-ini" placeholder="DD/MM/YYYY" class="siag-input">
                        </div>
                        <div>
                            <label class="campo-label">Hora</label>
                            <input type="text" id="q-hr-est-ini" value="00:00" class="siag-input">
                        </div>
                        <div>
                            <label class="campo-label">Dia Final Estufamento</label>
                            <input type="text" id="q-dt-est-fim" placeholder="DD/MM/YYYY" class="siag-input">
                        </div>
                        <div>
                            <label class="campo-label">Hora</label>
                            <input type="text" id="q-hr-est-fim" value="00:00" class="siag-input">
                        </div>

                        <div>
                            <label class="campo-label">Dia Inicial Expedição</label>
                            <input type="text" id="q-dt-exp-ini" placeholder="DD/MM/YYYY" class="siag-input">
                        </div>
                        <div>
                            <label class="campo-label">Hora</label>
                            <input type="text" id="q-hr-exp-ini" value="00:00" class="siag-input">
                        </div>
                        <div>
                            <label class="campo-label">Dia Final Expedição</label>
                            <input type="text" id="q-dt-exp-fim" placeholder="DD/MM/YYYY" class="siag-input">
                        </div>
                        <div>
                            <label class="campo-label">Hora</label>
                            <input type="text" id="q-hr-exp-fim" value="00:00" class="siag-input">
                        </div>
                    </div>

                    <!-- PRODUTO E PROGRAMA -->
                    <div class="grid-2 secao-bloco">
                        <div>
                            <div class="secao-header">
                                <span class="secao-titulo">Produto</span>
                                <span class="secao-linha"></span>
                            </div>
                            <div class="grid-3">
                                <div>
                                    <label class="campo-label">Produto</label>
                                    <input type="text" id="q-produto" placeholder="Produto" class="siag-input">
                                </div>
                                <div>
                                    <label class="campo-label">Cor</label>
                                    <input type="text" id="q-cor" placeholder="Cor" class="siag-input">
                                </div>
                                <div>
                                    <label class="campo-label">Tam./Grade</label>
                                    <input type="text" id="q-grade" placeholder="Tam./Grade" class="siag-input">
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="secao-header">
                                <span class="secao-titulo">Programa</span>
                                <span class="secao-linha"></span>
                            </div>
                            <div class="grid-2">
                                <div>
                                    <label class="campo-label">Programa</label>
                                    <input type="text" id="q-programa" placeholder="Programa" class="siag-input">
                                </div>
                                <div>
                                    <label class="campo-label">Documento</label>
                                    <input type="text" id="q-documento" placeholder="Documento" class="siag-input">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- PEDIDO -->
                    <div class="secao-bloco">
                        <div class="secao-header">
                            <span class="secao-titulo">Pedido</span>
                            <span class="secao-linha"></span>
                        </div>
                        <div class="grid-4">
                            <div>
                                <label class="campo-label">Lote</label>
                                <input type="text" id="q-lote" placeholder="Lote" class="siag-input">
                            </div>
                            <div>
                                <label class="campo-label">Box</label>
                                <input type="text" id="q-box" placeholder="Box" class="siag-input">
                            </div>
                            <div>
                                <label class="campo-label">Pedido</label>
                                <input type="text" id="q-pedido" placeholder="Pedido" class="siag-input">
                            </div>
                            <div>
                                <label class="campo-label">Canal de Venda</label>
                                <input type="text" id="q-canal" placeholder="Canal de Venda" class="siag-input">
                            </div>
                            <div>
                                <label class="campo-label">Cliente</label>
                                <input type="text" id="q-cliente" placeholder="Cliente" class="siag-input">
                            </div>
                        </div>
                    </div>

                    <!-- AGRUPADOR -->
                    <div class="secao-bloco">
                        <div class="secao-header">
                            <span class="secao-titulo">- Agrupador</span>
                            <span class="secao-linha"></span>
                        </div>
                        <div class="grid-4">
                            <div>
                                <label class="campo-label">Tipo de Agrupador</label>
                                <select id="q-tipo-agrup" class="siag-input">
                                    <option value="Indefinido" selected>Indefinido</option>
                                    <option value="Carga">Carga</option>
                                    <option value="Onda">Onda</option>
                                </select>
                            </div>
                            <div>
                                <label class="campo-label">Código 01</label>
                                <input type="text" id="q-cod1" placeholder="Código 01" class="siag-input">
                            </div>
                            <div>
                                <label class="campo-label">Código 02</label>
                                <input type="text" id="q-cod2" placeholder="Código 02" class="siag-input">
                            </div>
                            <div>
                                <label class="campo-label">Código 03</label>
                                <input type="text" id="q-cod3" placeholder="Código 03" class="siag-input">
                            </div>
                        </div>
                    </div>

                    <!-- NOTA FISCAL -->
                    <div class="secao-bloco">
                        <div class="secao-header">
                            <span class="secao-titulo">- Nota Fiscal</span>
                            <span class="secao-linha"></span>
                        </div>
                        <div class="grid-2">
                            <div>
                                <label class="campo-label">Série</label>
                                <input type="text" id="q-serie" placeholder="Série" class="siag-input">
                            </div>
                            <div>
                                <label class="campo-label">Nº Nota</label>
                                <input type="text" id="q-nota" placeholder="Nº nota" class="siag-input">
                            </div>
                        </div>
                    </div>

                    <!-- OUTROS -->
                    <div class="secao-bloco">
                        <div class="secao-header">
                            <span class="secao-titulo">- Outros</span>
                            <span class="secao-linha"></span>
                        </div>
                        <div class="grid-4">
                            <div>
                                <label class="campo-label">Etiq. Caixa</label>
                                <input type="text" id="q-etiqueta" placeholder="Etiqueta" class="siag-input">
                            </div>
                            <div>
                                <label class="campo-label">Pallet</label>
                                <input type="text" id="q-pallet" placeholder="Pallet" class="siag-input">
                            </div>
                            <div>
                                <label class="campo-label">Localização</label>
                                <input type="text" id="q-local" placeholder="Localização" class="siag-input">
                            </div>
                            <div>
                                <label class="campo-label">Ordem</label>
                                <input type="text" id="q-ordem" placeholder="Ordem" class="siag-input">
                            </div>
                        </div>
                    </div>

                    <!-- STATUS CAIXA -->
                    <div class="secao-bloco">
                        <div class="secao-header">
                            <span class="secao-titulo">- Status Caixa</span>
                            <span class="secao-linha"></span>
                        </div>

                        <div class="status-grid">
                            <label class="status-chk-label"><input type="checkbox" class="status-chk" value="Implantada"> <span>Implantada</span></label>
                            <label class="status-chk-label"><input type="checkbox" class="status-chk" value="Produzido"> <span>Produzido</span></label>
                            <label class="status-chk-label"><input type="checkbox" class="status-chk" value="Embalada"> <span>Embalada</span></label>
                            <label class="status-chk-label"><input type="checkbox" class="status-chk" value="Armazenada"> <span>Armazenada</span></label>
                            <label class="status-chk-label"><input type="checkbox" class="status-chk" value="Expedida"> <span>Expedida</span></label>
                            <label class="status-chk-label"><input type="checkbox" class="status-chk" value="Cancelada"> <span>Cancelada</span></label>
                            <label class="status-chk-label"><input type="checkbox" class="status-chk" value="Consumida"> <span>Consumida</span></label>
                            <label class="status-chk-label"><input type="checkbox" class="status-chk" value="Retrabalhada"> <span>Retrabalhada</span></label>
                        </div>

                        <div class="rodape-acoes">
                            <div style="width:110px;">
                                <label class="campo-label" style="font-size:10px; color:#64748b;">Max. Registros:</label>
                                <select id="q-max-reg" class="siag-input" style="padding:4px 6px;">
                                    <option value="1000" selected>1000</option>
                                    <option value="500">500</option>
                                    <option value="200">200</option>
                                </select>
                            </div>

                            <div style="display:flex; align-items:center; gap:6px;">
                                <button type="button" id="btn-pesquisar-caixas" class="btn-siag-azul">Pesquisar</button>
                                <button type="button" id="btn-exportar-caixas" class="btn-siag-azul" title="Exportar">⬇</button>
                                <button type="button" id="btn-gerar-servico" class="btn-siag-azul">Gerar pelo Serviço</button>
                            </div>
                        </div>
                    </div>
                </form>

                <!-- RESULTADO DA CONSULTA -->
                <div style="margin-top:14px; background:#ffffff; border:1px solid #b5c0d1; overflow-x:auto;">
                    <table class="siag-table">
                        <thead>
                            <tr>
                                <th>Etiqueta (SSCC)</th>
                                <th>Ordem</th>
                                <th>Produto</th>
                                <th>Cor</th>
                                <th>Grade</th>
