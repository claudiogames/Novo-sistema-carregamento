                <div style="background:#e8ecf4; border:1px solid #cbd5e1; padding:10px; display:flex; flex-wrap:wrap; gap:16px;">
                    <div style="display:flex; gap:10px;">
                        <div>
                            <div style="background:#2d74b8; color:white; font-size:10px; font-weight:700; padding:4px 8px; text-align:center; margin-bottom:4px;">Lado 1</div>
                            <div id="mapa-lado1"></div>
                        </div>
                        <div>
                            <div style="background:#38a86b; color:white; font-size:10px; font-weight:700; padding:4px 8px; text-align:center; margin-bottom:4px;">Lado 2</div>
                            <div id="mapa-lado2"></div>
                        </div>
                    </div>

                    <div style="flex:1; min-width:300px;">
                        <div id="titulo-portao-ativo" style="font-size:12px; font-weight:700; margin-bottom:8px;">
                            Portão 16 - Ordem de carregamento: 11122954
                        </div>
                        <div style="overflow-x:auto; background:white; border:1px solid #cbd5e1;">
                            <table class="siag-table">
                                <thead>
                                    <tr>
                                        <th>Px</th><th>Pallet</th><th>Lote</th><th>Box</th><th>Endereço</th><th>Caixas</th><th>Atividade</th><th>Operador</th>
                                    </tr>
                                </thead>
                                <tbody id="tbody-portao-pallets"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

            <!-- =================================================================== -->
            <!-- TELA DASHBOARD                                                      -->
            <!-- =================================================================== -->
            <section id="tela-dashboard" style="display:none; padding:8px;">
                <div style="background:#e8ecf4; border:1px solid #cbd5e1;">
                    <div class="siag-panel-bar">Menu Favorito</div>
                    <div style="padding:12px; display:flex; flex-wrap:wrap; gap:8px;">
                        <button type="button" data-nav="visualizacao" class="btn-favorito">Visão de Embarque</button>
                        <button type="button" data-nav="visualizacao" class="btn-favorito">Visualização Carregamento</button>
                        <button type="button" data-nav="consulta-caixas" class="btn-favorito">Pallet</button>
                        <button type="button" data-nav="visualizacao" class="btn-favorito">Visualização do CD</button>
                        <button type="button" id="btn-fav-caixas" data-nav="consulta-caixas" class="btn-favorito">Caixas</button>
                        <button type="button" data-nav="consulta-caixas" class="btn-favorito">Ordens</button>
                        <button type="button" data-nav="visualizacao" class="btn-favorito">Cargas Pendente</button>
                    </div>
                </div>
            </section>

        </main>
    </div>

    <script>
        (function() {
            var baseCaixas = [
                { etiqueta: '00478902440972369716', ordem: '11122954', produto: '38227', cor: 'CF835', grade: '64807', lote: '797412', box: '1621826', pallet: '029021', local: 'Portão 16', status: 'Expedida' },
                { etiqueta: '00478902440972369723', ordem: '11122954', produto: '38227', cor: 'CF840', grade: '06756', lote: '797412', box: '1621826', pallet: '001501', local: 'Portão 16', status: 'Expedida' },
                { etiqueta: '00478902440978848834', ordem: '11122789', produto: '27642', cor: 'CF880', grade: '05809', lote: '787553', box: '1628264', pallet: '003057', local: 'Fábrica 7', status: 'Embalada' },
                { etiqueta: '00478902440977129513', ordem: '11122789', produto: '12295', cor: 'CF921', grade: '36735', lote: '797616', box: '1631566', pallet: '029473', local: 'Porta Pallet BA-27', status: 'Armazenada' },
                { etiqueta: '00478902440957363722', ordem: '11122862', produto: '38140', cor: 'BY364', grade: '82064', lote: '354905', box: '1627851', pallet: '017578', local: 'Retrabalho CD', status: 'Retrabalhada' },
                { etiqueta: '00478902440979363135', ordem: '11122862', produto: '34520', cor: 'CA123', grade: '09745', lote: '354907', box: '1628403', pallet: '002041', local: 'Sorter Rampa 04', status: 'Produzido' }
            ];

            var portaoAtivo = 16;

            function navegar(tela, fecharMenu) {
                document.getElementById('tela-consulta-caixas').style.display = 'none';
                document.getElementById('tela-visualizacao').style.display = 'none';
                document.getElementById('tela-dashboard').style.display = 'none';

                var headerTitle = document.getElementById('header-title');
                if (tela === 'consulta-caixas') {
                    document.getElementById('tela-consulta-caixas').style.display = 'block';
                    headerTitle.textContent = 'Consulta caixas';
                    executarPesquisaCaixas();
                } else if (tela === 'visualizacao') {
                    document.getElementById('tela-visualizacao').style.display = 'block';
                    headerTitle.textContent = 'Visualização do CD';
                    renderizarMapaPortoes();
                } else if (tela === 'dashboard') {
                    document.getElementById('tela-dashboard').style.display = 'block';
                    headerTitle.textContent = 'Sistema Integrado de Armazenagem Grendene';
                }

                if (fecharMenu) {
                    document.getElementById('sidebar').classList.add('collapsed');
                }
            }

            function executarPesquisaCaixas() {
                var prod = (document.getElementById('q-produto').value || '').toLowerCase().trim();
                var cor = (document.getElementById('q-cor').value || '').toLowerCase().trim();
                var grade = (document.getElementById('q-grade').value || '').toLowerCase().trim();
                var lote = (document.getElementById('q-lote').value || '').toLowerCase().trim();
                var box = (document.getElementById('q-box').value || '').toLowerCase().trim();
                var pedido = (document.getElementById('q-pedido').value || '').toLowerCase().trim();
                var cliente = (document.getElementById('q-cliente').value || '').toLowerCase().trim();
                var cod1 = (document.getElementById('q-cod1').value || '').toLowerCase().trim();
                var nota = (document.getElementById('q-nota').value || '').toLowerCase().trim();
                var etiq = (document.getElementById('q-etiqueta').value || '').toLowerCase().trim();
                var pallet = (document.getElementById('q-pallet').value || '').toLowerCase().trim();
                var local = (document.getElementById('q-local').value || '').toLowerCase().trim();
                var ordem = (document.getElementById('q-ordem').value || '').toLowerCase().trim();
                var maxReg = Number(document.getElementById('q-max-reg').value) || 1000;

                var chks = document.querySelectorAll('.status-chk:checked');
                var statusSel = [];
                for (var c = 0; c < chks.length; c++) {
                    statusSel.push(chks[c].value);
                }

                var filtrados = [];
                for (var i = 0; i < baseCaixas.length; i++) {
                    var item = baseCaixas[i];
                    if (prod && item.produto.toLowerCase().indexOf(prod) === -1) continue;
                    if (cor && item.cor.toLowerCase().indexOf(cor) === -1) continue;
                    if (grade && item.grade.toLowerCase().indexOf(grade) === -1) continue;
                    if (lote && item.lote.toLowerCase().indexOf(lote) === -1) continue;
                    if (box && item.box.toLowerCase().indexOf(box) === -1) continue;
                    if (etiq && item.etiqueta.toLowerCase().indexOf(etiq) === -1) continue;
                    if (pallet && item.pallet.toLowerCase().indexOf(pallet) === -1) continue;
                    if (local && item.local.toLowerCase().indexOf(local) === -1) continue;
                    if (ordem && item.ordem.toLowerCase().indexOf(ordem) === -1) continue;
                    if (statusSel.length > 0 && statusSel.indexOf(item.status) === -1) continue;
                    filtrados.push(item);
                    if (filtrados.length >= maxReg) break;
                }

                var tbody = document.getElementById('tbody-consulta-caixas');
                if (filtrados.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="10" style="padding:14px; color:#64748b;">Nenhuma caixa encontrada para os filtros selecionados.</td></tr>';
                    return;
                }

                var html = '';
                for (var r = 0; r < filtrados.length; r++) {
                    var x = filtrados[r];
                    html += '<tr>' +
                        '<td style="font-family:monospace; font-weight:700; text-align:left;">' + x.etiqueta + '</td>' +
                        '<td style="color:#1d4ed8; font-weight:700;">' + x.ordem + '</td>' +
                        '<td>' + x.produto + '</td>' +
                        '<td>' + x.cor + '</td>' +
                        '<td>' + x.grade + '</td>' +
                        '<td>' + x.lote + '</td>' +
                        '<td>' + x.box + '</td>' +
                        '<td style="font-family:monospace;">' + x.pallet + '</td>' +
                        '<td>' + x.local + '</td>' +
                        '<td><span style="background:#dbeafe; color:#1e40af; padding:2px 6px; border-radius:2px; font-weight:600;">' + x.status + '</span></td>' +
                    '</tr>';
                }
                tbody.innerHTML = html;
            }

            function renderizarMapaPortoes() {
                var grid = document.getElementById('grid-portoes');
                var bloqueados = [1, 9, 21, 22, 23, 24, 25, 27, 28, 29, 30];
                var expedindo = [16, 17, 18];
                var html = '';

                for (var i = 1; i <= 30; i++) {
                    var num = i < 10 ? '0' + i : '' + i;
                    var cls = 'portao-btn portao-livre';
                    if (bloqueados.indexOf(i) > -1) cls = 'portao-btn portao-bloqueado';
                    if (expedindo.indexOf(i) > -1) cls = 'portao-btn portao-expedindo';
                    if (portaoAtivo === i) cls += ' selecionado';
                    html += '<button type="button" data-portao="' + i + '" class="' + cls + '">' + num + '</button>';
                }
                grid.innerHTML = html;

                var btns = grid.querySelectorAll('button[data-portao]');
                for (var b = 0; b < btns.length; b++) {
                    btns[b].addEventListener('click', function() {
                        portaoAtivo = Number(this.getAttribute('data-portao'));
                        renderizarMapaPortoes();
                    });
                }

                var numStr = portaoAtivo < 10 ? '0' + portaoAtivo : '' + portaoAtivo;
                document.getElementById('titulo-portao-ativo').textContent = 'Portão ' + numStr + ' - Ordem de carregamento: ' + (11122900 + portaoAtivo);

                var l1Html = '';
                var l2Html = '';
                for (var p = 1; p <= 11; p++) {
                    l1Html += '<div class="pos-btn pos-ocupada">' + p + '</div>';
                    l2Html += '<div class="pos-btn ' + (p <= 3 ? 'pos-livre' : 'pos-ocupada') + '">' + p + '</div>';
                }
                document.getElementById('mapa-lado1').innerHTML = l1Html;
                document.getElementById('mapa-lado2').innerHTML = l2Html;

                document.getElementById('tbody-portao-pallets').innerHTML =
                    '<tr><td>04 <span style="background:#38a86b; color:#fff; padding:1px 5px; border-radius:9px; font-size:10px;">L2</span></td><td style="background:#ef4444; color:#fff; font-weight:700;">029021</td><td>797412</td><td>1621826</td><td>Portão ' + numStr + '</td><td>60</td><td></td><td></td></tr>' +
                    '<tr><td>05 <span style="background:#38a86b; color:#fff; padding:1px 5px; border-radius:9px; font-size:10px;">L2</span></td><td style="background:#ef4444; color:#fff; font-weight:700;">001501</td><td>797412</td><td>1621826</td><td>Portão ' + numStr + '</td><td>299</td><td></td><td></td></tr>';
            }

            document.getElementById('btn-toggle-sidebar').addEventListener('click', function() {
                document.getElementById('sidebar').classList.toggle('collapsed');
            });

            document.getElementById('btn-inicio-top').addEventListener('click', function() {
                navegar('dashboard', false);
            });

            document.getElementById('menu-search').addEventListener('keyup', function() {
                var termo = this.value.toLowerCase();
                var lis = document.querySelectorAll('#sidebar-menu-list li');
                for (var i = 0; i < lis.length; i++) {
                    lis[i].style.display = lis[i].textContent.toLowerCase().indexOf(termo) > -1 ? 'block' : 'none';
                }
            });

            var navEls = document.querySelectorAll('[data-nav]');
            for (var n = 0; n < navEls.length; n++) {
                navEls[n].addEventListener('click', function() {
                    var destino = this.getAttribute('data-nav');
                    var fechar = this.tagName === 'LI';
                    navegar(destino, fechar);
                });
            }

            document.getElementById('btn-pesquisar-caixas').addEventListener('click', executarPesquisaCaixas);

            document.getElementById('btn-exportar-caixas').addEventListener('click', function() {
                var csv = 'Etiqueta;Ordem;Produto;Cor;Grade;Lote;Box;Pallet;Localizacao;Status\n';
                for (var i = 0; i < baseCaixas.length; i++) {
                    var x = baseCaixas[i];
                    csv += '"' + x.etiqueta + '";' + x.ordem + ';' + x.produto + ';' + x.cor + ';' + x.grade + ';' + x.lote + ';' + x.box + ';"' + x.pallet + '";"' + x.local + '";' + x.status + '\n';
                }
                var blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
                var a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = 'consulta_caixas_siag.csv';
                a.click();
            });

            document.getElementById('btn-gerar-servico').addEventListener('click', function() {
                alert('Consulta enviada para geração pelo serviço do SIAG.');
            });

            document.getElementById('select-setor').addEventListener('change', renderizarMapaPortoes);
            document.getElementById('btn-refresh-cd').addEventListener('click', renderizarMapaPortoes);

            executarPesquisaCaixas();
        })();
    </script>
</body>
</html>
