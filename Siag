                    }

                    var clsRow = st ? 'linha-alocada' : '';
                    if (isSel) clsRow += ' linha-selecionada';

                    html += '<tr data-select-ordem="' + o.id + '" class="' + clsRow + '" style="cursor:pointer;">' +
                        '<td style="font-family:monospace; font-weight:700;">' + o.id + '</td>' +
                        '<td style="text-align:left; font-weight:600;">' + o.cliente + '</td>' +
                        '<td>' + o.prazo + '</td>' +
                        '<td style="font-family:monospace; font-weight:700;">' + formatarNumero(paresTotais) + '</td>' +
                        '<td style="font-family:monospace;">' + formatarNumero(o.caixas) + '</td>' +
                        '<td style="font-family:monospace; font-weight:700;">' + o.pallets + '</td>' +
                        '<td style="font-family:monospace;">' + formatarTempoTurno(o.minutosTurno) + '</td>' +
                        '<td>' + statusBadge + '</td>' +
                        '<td style="font-family:monospace; font-size:10px;">' + fechamentoTxt + '</td>' +
                        '<td style="white-space:nowrap;">' +
                            '<div class="mini-prog-wrap"><div class="' + barCls + '" style="width:' + pctVisual + '%;"></div></div>' +
                            '<span style="font-family:monospace; font-size:10px; font-weight:700;">' + pctVisual + '%</span>' +
                        '</td>' +
                        '<td>' + acaoHtml + '</td>' +
                    '</tr>';
                }

                tbody.innerHTML = html;

                var selObj = encontrarOrdem(ordemSelecionadaId);
                if (selObj) {
                    var destStr = String(portaoDestinoSelecionado).padStart(2, '0');
                    document.getElementById('info-ordem-selecionada').innerHTML =
                        '<strong>Selecionada:</strong> ' + selObj.id + ' (' + selObj.cliente + ') → <strong>Portão Destino:</strong> PT ' + destStr +
                        ' • <strong>Prazo:</strong> ' + selObj.prazo +
                        ' • <strong>Pares:</strong> ' + formatarNumero(selObj.caixas * PARES_POR_CAIXA) +
                        ' • <strong>Caixas:</strong> ' + formatarNumero(selObj.caixas) +
                        ' • <strong>Pallets:</strong> ' + selObj.pallets +
                        ' • <strong>Preparo:</strong> 01:00 • <strong>Ciclo:</strong> ' + formatarMMSS(selObj.duracaoRealSeg);
                }

                var trs = tbody.querySelectorAll('tr[data-select-ordem]');
                for (var r = 0; r < trs.length; r++) {
                    trs[r].addEventListener('click', function() {
                        ordemSelecionadaId = this.getAttribute('data-select-ordem');
                        renderizarTabelaProgramacao();
                    });
                }

                var btnsAloc = tbody.querySelectorAll('button[data-alocar-id]');
                for (var a = 0; a < btnsAloc.length; a++) {
                    btnsAloc[a].addEventListener('click', function(ev) {
                        ev.stopPropagation();
                        var idA = this.getAttribute('data-alocar-id');
